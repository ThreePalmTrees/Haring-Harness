#!/usr/bin/env python3
"""stop — interrupt an OpenCode session so its worker stops working.

    stop <session>

A session whose client is gone goes on working in the server, and only an interrupt stops
it. Exits 0 when the server took the interrupt, 1 when it did not, with the reason on
standard error, and 2 when called wrongly.
"""
import sys
import api

if len(sys.argv) != 2:
    print("usage: stop <session>", file=sys.stderr)
    sys.exit(2)

ok, answer = api.opencode_api("POST", f"/api/session/{sys.argv[1]}/interrupt")
if not ok:
    print(answer[:300] or "the OpenCode server refused the interrupt", file=sys.stderr)
    sys.exit(1)
