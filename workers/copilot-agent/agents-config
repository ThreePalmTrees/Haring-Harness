#!/bin/sh
# agents-config — install, remove or check this worker's Copilot CLI subagent files.
#
#   agents-config install
#   agents-config remove
#   agents-config check <kind>
#
# The source agent files live in agents/<kind>.md beside this script. Copilot runs a
# personal subagent from ~/.copilot/agents/haring-<kind>.agent.md. install writes a
# generated copy, not a link, because the copy must inline bin/haring-prompt <kind> and
# the kind's schema in place of @RULES@. Its `model: auto` line is removed so the
# subagent inherits the manager's model, unless <haring-root>/models has a line for
# `copilot-agent <kind>`, which replaces it with that model; a link would keep the
# placeholders and the auto model, and a Copilot subagent cannot read files outside the
# project. Blank lines and lines whose first word starts with # in the models file are
# ignored, and the last line for the worker and kind wins. The copy goes stale whenever
# kinds/rules.md or kinds/<kind>/rules.md changes, so run ./install.sh after editing
# kinds/. It also carries a marker naming its source file, and remove deletes only
# regular files whose marker points into this directory's agents/.
set -e

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HARING=$(CDPATH= cd -- "$HERE/../.." && pwd)
AGENTS=$HOME/.copilot/agents

tmp=""; prompt_tmp=""
trap '[ -n "$tmp" ] && rm -f "$tmp"; [ -n "$prompt_tmp" ] && rm -f "$prompt_tmp"' 0

usage() {
  echo "usage: agents-config install|remove|check <kind>" >&2
  exit 2
}

marker_source() {  # marker_source <file>
  sed -n 's|^<!-- haring source: \(.*\) -->$|\1|p' "$1" | tail -n 1
}

model_of() {  # model_of <kind>
  model_of_value=""
  [ -f "$HARING/models" ] || return 0
  while read -r model_worker model_kind model_name model_rest || [ -n "$model_worker" ]; do
    case "$model_worker" in
      ''|'#'*) continue ;;
    esac
    [ "$model_worker" = copilot-agent ] && [ "$model_kind" = "$1" ] || continue
    [ -n "$model_name" ] || continue
    model_of_value=$model_name
  done < "$HARING/models"
}

render() {  # render <source> <destination>
  r_src=$1; r_dest=$2
  r_kind=$(basename "$r_src" .md)
  model_of "$r_kind"
  r_prompt=$(mktemp "${TMPDIR:-/tmp}/haring-copilot-prompt.XXXXXX")
  prompt_tmp=$r_prompt
  "$HARING/bin/haring-prompt" "$r_kind" > "$r_prompt"
  awk -v haring="$HARING" -v prompt="$r_prompt" \
      -v schema="$HARING/kinds/$r_kind/schema.json" -v model="$model_of_value" '
    $0 == "model: auto" {
      if (model != "") print "model: " model
      next
    }
    $0 == "@RULES@" {
      while ((getline line < prompt) > 0) print line
      close(prompt)
      print ""
      print "```json"
      while ((getline line < schema) > 0) print line
      close(schema)
      print "```"
      next
    }
    { gsub("@HARING@", haring); print }
  ' "$r_src" > "$r_dest"
  rm -f "$r_prompt"; prompt_tmp=""
  printf '\n<!-- haring source: %s -->\n' "$r_src" >> "$r_dest"
}

do_install() {
  mkdir -p "$AGENTS"
  failed=0
  for f in "$HERE"/agents/*.md; do
    [ -f "$f" ] || continue
    kind=$(basename "$f" .md)
    dest=$AGENTS/haring-$kind.agent.md
    if [ -L "$dest" ]; then rm -f "$dest"; fi
    if [ -e "$dest" ] && { [ ! -f "$dest" ] || [ "$(marker_source "$dest")" != "$f" ]; }; then
      printf '  SKIP    %s exists and was not made by this worker. Move it aside, then run this again.\n' "$dest" >&2
      failed=1; continue
    fi
    tmp=$(mktemp "${TMPDIR:-/tmp}/haring-copilot-agent.XXXXXX")
    render "$f" "$tmp"
    if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
      printf '  same    %s\n' "$dest"
    else
      existed=0
      [ -e "$dest" ] && existed=1
      cp "$tmp" "$dest"
      if [ "$existed" = 1 ]; then printf '  updated %s\n' "$dest"; else printf '  new     %s\n' "$dest"; fi
    fi
    rm -f "$tmp"; tmp=""
  done
  if ! command -v copilot >/dev/null 2>&1; then
    echo "warning: copilot is not on your PATH. The manager starts these agents from" >&2
    echo "  GitHub Copilot CLI; install it, then sign in with: copilot login" >&2
  fi
  [ "$failed" = 0 ] || exit 1
}

do_remove() {
  for name in "$AGENTS"/haring-*.agent.md; do
    [ -f "$name" ] || continue
    [ -L "$name" ] && continue
    case "$(marker_source "$name")" in
      "$HERE"/agents/*) rm -f "$name"; printf '  removed %s\n' "$name" ;;
    esac
  done
}

do_check() {  # do_check <kind>
  kind=$1
  command -v copilot >/dev/null 2>&1 || {
    echo "haring-worker: copilot is not on PATH. Install GitHub Copilot CLI, then run ./install.sh again." >&2; exit 1; }
  src=$HERE/agents/$kind.md
  [ -f "$src" ] || {
    echo "haring-worker: there is no Copilot subagent source for $kind at $src." >&2; exit 1; }
  dest=$AGENTS/haring-$kind.agent.md
  tmp=$(mktemp "${TMPDIR:-/tmp}/haring-copilot-agent.XXXXXX")
  render "$src" "$tmp"
  if [ -L "$dest" ] || [ ! -f "$dest" ] || ! cmp -s "$tmp" "$dest"; then
    echo "haring-worker: the haring-$kind Copilot subagent is not installed or is out of date in ~/.copilot/agents." >&2
    echo "  Run $HERE/agents-config install." >&2
    exit 1
  fi
  rm -f "$tmp"; tmp=""
}

[ $# -ge 1 ] || usage
case "$1" in
  install) [ $# -eq 1 ] || usage; do_install ;;
  remove)  [ $# -eq 1 ] || usage; do_remove ;;
  check)   [ $# -eq 2 ] && [ -n "$2" ] || usage; do_check "$2" ;;
  *) usage ;;
esac
