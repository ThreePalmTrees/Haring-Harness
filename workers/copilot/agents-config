#!/bin/sh
# agents-config — install, remove or check this worker's Copilot CLI agent files.
#
#   agents-config install
#   agents-config remove
#   agents-config check <kind>
#
# The agent files live in agents/<kind>.md beside this script. Copilot finds a personal
# agent by the file it is linked as, so each one is linked into ~/.copilot/agents as
# haring-cli-<kind>.agent.md. The plain haring-<kind> names belong to the subagent worker,
# workers/copilot-agent. The link rules and messages are the ones install.sh uses for
# every link: same, moved, new, and SKIP when a plain file is in the way.
#
# remove deletes only the links that point into this directory's agents/, so a plain file
# and a link to somewhere else are left alone. check exits 0 when copilot is on PATH and
# the kind's link is installed, and 1 with the reason when either is missing.
set -e

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HARING=$(CDPATH= cd -- "$HERE/../.." && pwd)
AGENTS=$HOME/.copilot/agents

usage() {
  echo "usage: agents-config install|remove|check <kind>" >&2
  exit 2
}

link() {  # link <target> <linkname>
  target=$1; name=$2
  if [ -L "$name" ]; then
    old=$(readlink "$name")
    if [ "$old" = "$target" ]; then printf '  same    %s\n' "$name"; return; fi
    ln -sfn "$target" "$name"; printf '  moved   %s\n            was %s\n' "$name" "$old"; return
  fi
  if [ -e "$name" ]; then
    printf '  SKIP    %s exists and is not a link. Move it aside, then run this again.\n' "$name" >&2
    failed=1; return
  fi
  ln -sfn "$target" "$name"; printf '  new     %s\n' "$name"
}

do_install() {
  mkdir -p "$AGENTS"
  failed=0
  for f in "$HERE"/agents/*.md; do
    [ -f "$f" ] || continue
    kind=$(basename "$f" .md)
    link "$f" "$AGENTS/haring-cli-$kind.agent.md"
  done
  if ! command -v copilot >/dev/null 2>&1; then
    echo "warning: copilot is not on your PATH. Workers run in GitHub Copilot CLI;" >&2
    echo "  install it, then sign in with: copilot login" >&2
  fi
  [ "$failed" = 0 ] || exit 1
}

do_remove() {
  for name in "$AGENTS"/*; do
    [ -L "$name" ] || continue
    case "$(readlink "$name")" in
      "$HERE"/agents/*) rm -f "$name"; printf '  removed %s\n' "$name" ;;
    esac
  done
}

do_check() {  # do_check <kind>
  kind=$1
  command -v copilot >/dev/null 2>&1 || {
    echo "haring-worker: copilot is not on PATH. Install GitHub Copilot CLI, then run ./install.sh again." >&2; exit 1; }
  [ -e "$AGENTS/haring-cli-$kind.agent.md" ] || {
    echo "haring-worker: the haring-cli-$kind agent is not installed in ~/.copilot/agents." >&2
    echo "  Run ./install.sh in $HARING, which links it there." >&2; exit 1; }
}

[ $# -ge 1 ] || usage
case "$1" in
  install) [ $# -eq 1 ] || usage; do_install ;;
  remove)  [ $# -eq 1 ] || usage; do_remove ;;
  check)   [ $# -eq 2 ] && [ -n "$2" ] || usage; do_check "$2" ;;
  *) usage ;;
esac
