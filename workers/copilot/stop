#!/usr/bin/env python3
"""stop — report whether the Copilot session's -p process is still alive.

    stop <session>

Copilot CLI -p runs inside the process haring-kill has already signalled. There is no
separate session to interrupt, so this looks for a live copilot process that names the
session after --session-id, --resume or -r. A command line that only repeats the id, such
as the prompt of a worker that was asked to run this command, is not a copilot process.

Exits 0 when none is left, 1 naming the pid when one is, and 2 when called wrongly.
"""
import re
import subprocess
import sys

if len(sys.argv) != 2:
    print("usage: stop <session>", file=sys.stderr)
    sys.exit(2)

session = sys.argv[1]
flag = re.compile(r"(?:--session-id|--resume|-r)(?:=|\s+)" + re.escape(session) + r"(?=$|\s)")
out = subprocess.run(["ps", "-axo", "pid=,stat=,command="], capture_output=True, text=True).stdout
for line in out.splitlines():
    parts = line.strip().split(None, 2)
    if len(parts) != 3:
        continue
    pid, stat, command = parts
    if "Z" in stat or "copilot" not in command:
        continue
    if flag.search(command):
        print(f"the Copilot session {session} is still running as pid {pid}", file=sys.stderr)
        sys.exit(1)
sys.exit(0)
