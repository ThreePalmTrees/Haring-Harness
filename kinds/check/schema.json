{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "task_as_i_read_it": {
   "type": "string",
   "description": "the task as you read it, in your own words, one or two sentences, written before the work. The manager compares it with what was sent, so a misreading shows here."
  },
  "narrowest_reading": {
   "type": "string",
   "description": "only if the task was ambiguous: the narrowest reading you took, and what the other reading would have been. Empty if it was not ambiguous."
  },
  "followups": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "work you found that mattered and did not do, one line each. Empty if there is none."
  },
  "claim_checked": {
   "type": "string"
  },
  "verdict": {
   "type": "string",
   "enum": [
    "true",
    "false",
    "partly",
    "could_not_check"
   ]
  },
  "what_is_actually_the_case": {
   "type": "string"
  },
  "where": {
   "type": "string"
  },
  "evidence": {
   "type": "string",
   "enum": [
    "ran_a_command",
    "read_the_code",
    "reasoning_only"
   ]
  },
  "command": {
   "type": "string"
  },
  "output": {
   "type": "string"
  },
  "line_numbers_at": {
   "type": "string"
  },
  "one_true_thing": {
   "type": "string",
   "description": "one line: what would most change how the next task is planned. Say so if there is nothing."
  },
  "environment": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "what_failed": {
     "type": "string"
    }
   },
   "required": [
    "ok",
    "what_failed"
   ]
  },
  "redacted": {
   "type": "boolean"
  },
  "doubts": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "needs_the_client": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "did_not_check": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "weak_evidence": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "needs_the_client",
    "did_not_check",
    "weak_evidence"
   ]
  }
 },
 "required": [
  "task_as_i_read_it",
  "claim_checked",
  "verdict",
  "what_is_actually_the_case",
  "where",
  "evidence",
  "line_numbers_at",
  "one_true_thing",
  "environment",
  "redacted",
  "doubts"
 ]
}