#!/usr/bin/env python3
"""haring-wait — follow a worker, then print what it returned.

    haring-wait <run-folder> [max-seconds]

While the worker is running, its steps are printed to standard error as they happen:
one line per tool call, with a run of the same tool folded onto one line that counts
them, naming how many distinct arguments the fold has held when they were not all the
same. Its thinking and its speech reach the same stream as they happen, one line per
line of the block, a block of more lines than are being kept showing its last few —
three while the worker is working, ten once this wait has had to say there is no step —
named in the column the tool name sits in. The stream arrives whole from
lib/haring_events.py — one entry per tool call, one whole block per thought — and the
folding and the keeping are done here, because this panel is the only reader with a
row budget. Every line names the run it belongs to, so
the kept lines are self-labelling wherever they are read, and a worker that produces
nothing for a minute says so — one that is waiting on the endpoint says that instead.
The report goes to standard output when it lands, so a caller redirecting stdout gets
the report and nothing else.

Exits 0 when the worker reported, and 1 when it left a report that cannot be read.
Exits 2 when it was called wrongly: no arguments, or a path that is not a haring run
folder. One exit is neither of those, and it is the interesting one:

    3   the worker has gone and left no report at all

It means "no report, but there may be work on disk", and it prints the progress file so
the next reader starts from something real. A run stopped with `haring-kill` arrives here
too, and says so: both leave an empty report, but a stop on purpose and a crash are
different things, and the `stopped` file haring-kill writes is what tells them apart.
A run that stopped itself for silence arrives here too, through the `stalled` file it
leaves naming how long the silence was.

Waits while the worker process is alive. A clock alone is the wrong test: real work has
run for twenty-seven minutes, and a fixed time limit only makes the manager restart the
wait, which costs a round trip and tells it nothing.
"""
import sys, os, time, subprocess

USAGE = "usage: haring-wait <run-folder> [max-seconds]"
HARING = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
# The panel clips at its own width and the file keeps the rest, so this is set by what
# keeps the tail usable rather than by what fits on screen: the panel reads the last
# 8 KB, and a long line spends that budget on itself that the kept lines could have had.
# 500 sits under it with room, and holds a long command whole for anyone reading the
# file rather than the panel.
WIDTH = 500

# Turning the event stream into entries lives in lib/, shared with the other commands
# that read a run. The reader hands the stream whole — one entry per tool call, one
# whole block per thought — and the compressions this panel needs are applied here,
# in shown(), so the other readers keep every call and every line.
sys.path.insert(0, os.path.join(HARING, "lib"))
import haring_events


def die(message, code):
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


def resolve_run(arg):
    """The run folder named by the argument: a path as given, or a bare run name.

    A path is used as it stands, relative ones included, and is known by its meta file.
    A name with no slash is looked up under the current project's runs folder, the
    project being the git top level of the working directory, as haring-pulse resolves
    it. Each way of failing says which way it was.
    """
    run = arg.rstrip("/")
    if os.path.isfile(os.path.join(run, "meta")):
        return run
    if "/" in run:
        die(f"not a haring run folder: {run}", 2)
    top = subprocess.run(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    runs = os.path.join(top or os.getcwd(), ".haring", "runs")
    found = os.path.join(runs, run)
    if not os.path.isfile(os.path.join(found, "meta")):
        die(f"no run named {run} under {runs}", 2)
    return found


argv = sys.argv[1:]
if not 1 <= len(argv) <= 2:
    print(USAGE, file=sys.stderr)
    sys.exit(2)
limit = argv[1] if len(argv) == 2 else "7200"
if not limit.isdigit():
    die(f"max-seconds must be a number, got: {limit}", 2)
limit = int(limit)

# A run folder is known by its meta file, the same marker `haring-worker continue` uses;
# the argument may also be a bare run name under the current project.
run = resolve_run(argv[0])
meta_path = os.path.join(run, "meta")
meta = dict(l.strip().split("=", 1) for l in open(meta_path) if "=" in l)
# Time is measured from the worker, not from this wait, because the two can start minutes
# apart. The meta file is last written when the worker's runner records its own pid, so its
# modification time is the moment the worker began.
started = os.path.getmtime(meta_path)
pid = int(meta["pid"]) if meta.get("pid", "").isdigit() else None
report = os.path.join(run, "report.json")
progress = os.path.join(run, "PROGRESS.md")
# Written by haring-kill when a person stopped this run on purpose. It is the only thing
# that separates a deliberate stop from a worker that died on its own, since both leave
# the same empty report.
stopped = os.path.join(run, "stopped")
# Written by the run itself when nothing reached its events for fifteen minutes: the run
# stopped rather than sit on an endpoint that had stopped answering.
stalled = os.path.join(run, "stalled")

# The worker's own event stream, written to the run folder as it happens. It is the one
# record haring owns: Claude Code's transcript lives at a path nothing promises, and when
# that moved, everything watching a run went blind while the worker carried on. What is
# read out of it here is the worker's tool calls, thinking and speech. Tool results stay
# hidden: a result can be a whole file.
events = os.path.join(run, "events.jsonl")

# Every line carries the run's identity, because a header at the top of the stream would
# have scrolled away before the first step. The date
# and time of the stamp are dropped and the kind and pid kept:
# 2026-09-06-150947-implement-10407 becomes implement-10407.
parts = os.path.basename(run).split("-")
rid = "-".join(parts[4:]) if len(parts) > 5 else os.path.basename(run)


def alive():
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def landed():
    return os.path.exists(report) and os.path.getsize(report) > 0


def fmt_elapsed(s):
    s = max(0, int(s))
    return f"{s // 60}m{s % 60:02d}s"


def elapsed():
    return fmt_elapsed(time.time() - started)


def event_elapsed(ts):
    return fmt_elapsed(haring_events.ts_value(ts) - started)


def say(tool, arg, ts):
    head = f"{rid} {event_elapsed(ts)} {tool:<12s} "
    # Clipped here rather than left to the panel: a line that wraps costs a second row
    # to itself.
    print((head + arg)[:WIDTH].rstrip(), file=sys.stderr, flush=True)


# The panel this feeds has a row budget, so the two compressions that lose evidence
# live here, applied to the entries the reader returns. The fold turns a run of one
# tool into counted lines — one at the second call and one at each doubling — and the
# line that prints carries the most recent argument; calls that differed say how many
# distinct ones the fold has held. The same call repeating is a worker stuck in a loop
# and keeps the plain form. A thought longer than the rows being kept prints a count
# line ahead of its last few: the ending of a thought is the part that says whether
# the route is wrong, and the count keeps the kept rows from being taken for the
# whole thought. The kept count is chosen on the events' own moments, not this
# reader's clock, so a replay sees the silences a live watch saw: while the worker is
# acting, BLOCK_LINES_WORKING are enough of the ending and the steps keep the rest of
# the panel; once it has been quiet since its last step for as long as the waiting
# line needs, the thought is all there is to read and it keeps BLOCK_LINES. The
# reader's when_ts advances exactly as the entries are produced — on every tool call
# and every retry line — so stepping through them with a last-step moment of our own,
# starting at the moment the worker began, reproduces its choice.
def shown(entries):
    tool, n, nxt, args = None, 0, 2, set()
    step_ts = started
    for label, text, ts in entries:
        if label == "api_retry":
            step_ts = haring_events.ts_value(ts)
            yield label, text, ts
        elif label in ("thinking", "says"):
            rows = text.splitlines()
            kept = (haring_events.BLOCK_LINES
                    if haring_events.ts_value(ts) - step_ts >= haring_events.IDLE_AFTER
                    else haring_events.BLOCK_LINES_WORKING)
            if len(rows) > kept:
                yield label, f"{len(rows) - kept} earlier lines of this block not shown", ts
                rows = rows[-kept:]
            for l in rows:
                yield label, l, ts
        else:
            step_ts = haring_events.ts_value(ts)
            if label == tool:
                n += 1
                args.add(text)
                if n >= nxt:
                    if len(args) == 1:
                        yield label, f"x{n} {text}", ts
                    else:
                        yield label, f"x{n} {len(args)} different, last: {text}", ts
                    nxt = n * 2
            else:
                tool, n, nxt, args = label, 1, 2, {text}
                yield label, text, ts


# The gap between two steps is the number worth reading: a step that sits for minutes
# is how a stuck worker shows itself, and when nothing at all arrives the loop below
# says so on its own.
reader = haring_events.RunReader(when_ts=started)
waited, last_idle = 0, 0.0
while not landed():
    if os.path.exists(events):
        for label, text, ts in shown(reader.read(events)):
            say(label, text, ts)
    now = time.time()
    quiet = now - reader.when
    if alive() and quiet >= haring_events.IDLE_AFTER \
            and now - last_idle >= haring_events.IDLE_AFTER:
        last_idle = now
        # Once a minute, in the tool column the steps use, so the display keeps its shape
        # and a stalled worker looks different from a busy one.
        if reader.last == "retry":
            say("waiting", f"on the endpoint, {reader.retries} retries so far", None)
        elif now - reader.seen_at < haring_events.IDLE_AFTER / 2:
            # Not the word used for a thinking block: that label carries the worker's own
            # words, and this line carries none. A reader must be able to tell a thought
            # from a report that there is no thought yet.
            say("waiting", f"no step for {fmt_elapsed(quiet)}, thinking", None)
        else:
            say("waiting", f"alive, but nothing new for {fmt_elapsed(quiet)}", None)
    if not alive():
        time.sleep(3)   # it may still be writing
        break
    if waited >= limit:
        break
    time.sleep(1)
    waited += 1

if not landed():
    if os.path.exists(stopped):
        rec = dict(l.strip().split("=", 1) for l in open(stopped) if "=" in l)
        print(f"this run was stopped on purpose with haring-kill at {rec.get('at', '?')} "
              f"by {rec.get('user', '?')}.", file=sys.stderr)
        print("Its work ends where it had got to. Read the progress and the events it",
              file=sys.stderr)
        print("before you build on any of it.", file=sys.stderr)
    elif os.path.exists(stalled):
        rec = dict(l.strip().split("=", 1) for l in open(stalled) if "=" in l)
        print(f"this run stopped itself at {rec.get('at', '?')} after "
              f"{rec.get('silent', '?')}s of silence.", file=sys.stderr)
        print("Nothing reached its events for that long, which is how a run looks when",
              file=sys.stderr)
        print("the endpoint has stopped answering. Read the progress before you build on",
              file=sys.stderr)
        print("it.", file=sys.stderr)
    elif alive():
        print(f"still running after {waited}s. The process is alive.", file=sys.stderr)
    else:
        print("the worker has gone and left no report. Read the progress and the tree before",
              file=sys.stderr)
        print("you believe anything about this run.", file=sys.stderr)
    if os.path.exists(progress) and os.path.getsize(progress):
        print("--- progress ---", file=sys.stderr)
        print(open(progress).read(), file=sys.stderr)
    sys.exit(3)

# A wait that joined after the run finished has read nothing live; this replay is what it
# shows instead, with the time each call was made taken from the events themselves.
if os.path.exists(events):
    for label, text, ts in shown(reader.read(events)):
        say(label, text, ts)

stats = os.path.join(run, "stats.txt")
if os.path.exists(stats) and os.path.getsize(stats):
    sys.stdout.write(open(stats).read())
else:
    subprocess.run([os.path.join(HARING, "bin", "haring-stats"), run])
print()
# Flush before handing the terminal to another program: what this script has written is
# still in Python's buffer when stdout is a pipe, and the child writes to the file
# descriptor directly, so without this the report prints above the numbers.
sys.stdout.flush()
rc = subprocess.run([os.path.join(HARING, "bin", "haring-report"), run]).returncode
err = os.path.join(run, "stderr.txt")
if os.path.exists(err) and os.path.getsize(err):
    print("\n--- stderr ---")
    sys.stdout.write(open(err).read())
sys.exit(rc)
