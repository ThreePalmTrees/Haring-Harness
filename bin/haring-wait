#!/usr/bin/env python3
"""haring-wait — follow a worker, then print what it returned.

    haring-wait <run-folder> [max-seconds]

While the worker is running, its steps are printed to standard error as they happen:
one line per tool call, with a run of the same tool folded onto one line that counts
them. Its thinking and its speech reach the same stream as they happen, one line per
line of the block, a block of more lines than are being kept showing its last few —
three while the worker is working, ten once this wait has had to say there is no step —
named in the column the tool name sits in. Every line names the run it belongs to, so
the kept lines are self-labelling
wherever they are read, and a worker that produces nothing for a minute says so — one
that is waiting on the endpoint says that instead. The report goes to standard output
when it lands, so a caller redirecting stdout gets the report and nothing else.

Exits 0 when the worker reported, and 1 when it left a report that cannot be read.
Exits 2 when it was called wrongly: no arguments, or a path that is not a haring run
folder. One exit is neither of those, and it is the interesting one:

    3   the worker has gone and left no report at all

It means "no report, but there may be work on disk", and it prints the progress file so
the next reader starts from something real. A run stopped with `haring-kill` arrives here
too, and says so: both leave an empty report, but a stop on purpose and a crash are
different things, and the `stopped` file haring-kill writes is what tells them apart.

Waits while the worker process is alive. A clock alone is the wrong test: real work has
run for twenty-seven minutes, and a fixed time limit only makes the manager restart the
wait, which costs a round trip and tells it nothing.
"""
import sys, os, json, time, subprocess
from datetime import datetime

USAGE = "usage: haring-wait <run-folder> [max-seconds]"
HARING = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
# The panel clips at its own width and the file keeps the rest, so this is set by what
# keeps the tail usable rather than by what fits on screen: the panel reads the last 8 KB
# and shows ten lines, so a line longer than 819 characters would leave fewer than ten to
# choose from. 500 sits under that with room, and holds a long command whole for anyone
# reading the file rather than the panel.
WIDTH = 500
BLOCK_LINES = 10  # the panel's own row count: a thought ends with its conclusion
BLOCK_LINES_WORKING = 3  # while the worker acts, the steps need the rest of the panel
IDLE_AFTER = 60   # seconds without a printed step before this wait speaks up


def die(message, code):
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


argv = sys.argv[1:]
if not 1 <= len(argv) <= 2:
    print(USAGE, file=sys.stderr)
    sys.exit(2)
run = argv[0].rstrip("/")
limit = argv[1] if len(argv) == 2 else "7200"
if not limit.isdigit():
    die(f"max-seconds must be a number, got: {limit}", 2)
limit = int(limit)

# A run folder is known by its meta file, the same marker `haring-worker continue` uses.
if not os.path.isfile(os.path.join(run, "meta")):
    die(f"not a haring run folder: {run}", 2)
meta_path = os.path.join(run, "meta")
meta = dict(l.strip().split("=", 1) for l in open(meta_path) if "=" in l)
# Time is measured from the worker, not from this wait, because the two can start minutes
# apart. The meta file is last written when the worker's runner records its own pid, so its
# modification time is the moment the worker began.
started = os.path.getmtime(meta_path)
pid = int(meta["pid"]) if meta.get("pid", "").isdigit() else None
report = os.path.join(run, "report.json")
progress = os.path.join(run, "PROGRESS.md")
# Written by haring-kill when a person stopped this run on purpose. It is the only thing
# that separates a deliberate stop from a worker that died on its own, since both leave
# the same empty report.
stopped = os.path.join(run, "stopped")

# The worker's own event stream, written to the run folder as it happens. It is the one
# record haring owns: Claude Code's transcript lives at a path nothing promises, and when
# that moved, everything watching a run went blind while the worker carried on. What is
# read out of it here is the worker's tool calls, thinking and speech. Tool results stay
# hidden: a result can be a whole file, and the panel that shows these lines is ten rows.
events = os.path.join(run, "events.jsonl")

# Every line carries the run's identity, because the panel these lines are read in keeps
# only the last ten and a header would have scrolled away before the first step. The date
# and time of the stamp are dropped and the kind and pid kept:
# 2026-09-06-150947-implement-10407 becomes implement-10407.
parts = os.path.basename(run).split("-")
rid = "-".join(parts[4:]) if len(parts) > 5 else os.path.basename(run)


def alive():
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def landed():
    return os.path.exists(report) and os.path.getsize(report) > 0


def fmt_elapsed(s):
    s = max(0, int(s))
    return f"{s // 60}m{s % 60:02d}s"


def elapsed():
    return fmt_elapsed(time.time() - started)


# assistant and user events carry the UTC moment they happened; system events carry none
# and take the moment this wait read them, which for a live tail is the same second.
# Stamping from the event rather than from the clock is what lets a wait that joined late
# replay a run with the real time each call was made.
def ts_value(ts):
    if ts:
        try:
            return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except ValueError:
            pass
    return time.time()


def event_elapsed(ts):
    return fmt_elapsed(ts_value(ts) - started)


def say(tool, arg, ts):
    head = f"{rid} {event_elapsed(ts)} {tool:<12s} "
    # Clipped here rather than left to the panel: a line that wraps costs two of the ten
    # rows the display has.
    print((head + arg)[:WIDTH].rstrip(), file=sys.stderr, flush=True)


def steps(path, pos, seen, state):
    """Print every step, thought and line of speech added since the last read.

    Each line carries the run, how long the worker had been running when it made the
    call, the tool, and the tool's main argument. The gap between two steps is the
    number worth reading: a step that sits for minutes is how a stuck worker shows
    itself, and when nothing at all arrives the loop below says so on its own.
    """
    with open(path) as f:
        f.seek(pos)
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            state["seen_at"] = time.time()
            # The endpoint refusing the worker shows up here and nowhere else, so it is
            # announced like a step: it is the answer to "why has nothing happened".
            if d.get("type") == "system" and d.get("subtype") == "api_retry":
                state["retries"] += 1
                state["last"] = "retry"
                state["when"] = time.time()
                state["when_ts"] = ts_value(d.get("timestamp"))
                if state["retries"] >= state["retry_next"]:
                    say("api_retry", f"x{state['retries']} waiting on the endpoint",
                        d.get("timestamp"))
                    state["retry_next"] = state["retries"] * 2
                continue
            # A system event of subtype permission_denied carries a plain string here,
            # not an object, so every run where the deny list fires reaches this line with
            # a str. Anything without a content list has no tool call in it either way.
            message = d.get("message")
            content = message.get("content") if isinstance(message, dict) else None
            if not isinstance(content, list):
                continue
            for b in content:
                if not isinstance(b, dict):
                    continue
                # A thought or a line of speech prints in the layout a step uses, with its
                # kind where the tool name sits, so the three are told apart at a glance.
                # These feed only seen_at, not when: a worker can think for minutes
                # without a step and is not stalled.
                kind = b.get("type")
                if kind in ("thinking", "text"):
                    ts = d.get("timestamp")
                    label = "thinking" if kind == "thinking" else "says"
                    rows = [l for l in (" ".join(x.split()) for x in (b.get(kind) or "").splitlines()) if l]
                    # A single thought has filled 485 rows here and pushed every tool call
                    # out of the panel, and the ending of a thought is the part that says
                    # whether the route is wrong. The count line ahead of the kept rows
                    # keeps a reader from taking them for the whole thought. While the
                    # worker is acting, three rows are enough of the ending and the steps
                    # keep the rest of the panel; once it has been quiet since its last
                    # step for as long as the waiting line needs, the thought is all there
                    # is to read and it keeps ten. Measured on the events' own moments, not
                    # this reader's clock, so a replay sees the silences a live watch saw.
                    kept = BLOCK_LINES if ts_value(ts) - state["when_ts"] >= IDLE_AFTER else BLOCK_LINES_WORKING
                    if len(rows) > kept:
                        say(label, f"{len(rows) - kept} earlier lines of this block not shown", ts)
                        rows = rows[-kept:]
                    for l in rows:
                        say(label, l, ts)
                    continue
                if kind != "tool_use":
                    continue
                if b.get("id") in seen:
                    continue
                seen.add(b.get("id"))
                i = b.get("input") or {}
                arg = i.get("command") or i.get("file_path") or i.get("pattern") or ""
                arg = " ".join(str(arg).split())
                name = b.get("name", "?")
                ts = d.get("timestamp")
                state["when"] = time.time()
                state["when_ts"] = ts_value(ts)
                state["last"] = "step"
                if name == state["tool"]:
                    state["n"] += 1
                    # A run of one tool — a scan, a string of edits — would spend the
                    # whole display on near-identical rows. It gets one line at the
                    # second call and one at each doubling, and the line that does print
                    # carries the most recent argument.
                    if state["n"] >= state["next"]:
                        say(name, f"x{state['n']} {arg}", ts)
                        state["next"] = state["n"] * 2
                else:
                    state["tool"], state["n"], state["next"] = name, 1, 2
                    say(name, arg, ts)
        return f.tell()


# when: the last time a step or a retry was printed, which is what "the worker has done
# nothing" is measured from. when_ts: the same thing on the events' own moments, which is
# what the block tails are measured on. seen_at: the last time the stream produced anything
# at all, thinking included, which separates a worker that is generating from one that is
# silent.
state = {"tool": None, "n": 0, "next": 2, "retries": 0, "retry_next": 1,
         "when": time.time(), "when_ts": started, "seen_at": 0.0, "last": None}
pos, seen, waited, last_idle = 0, set(), 0, 0.0
while not landed():
    if os.path.exists(events):
        pos = steps(events, pos, seen, state)
    now = time.time()
    quiet = now - state["when"]
    if alive() and quiet >= IDLE_AFTER and now - last_idle >= IDLE_AFTER:
        last_idle = now
        # Once a minute, in the tool column the steps use, so the display keeps its shape
        # and a stalled worker looks different from a busy one.
        if state["last"] == "retry":
            say("waiting", f"on the endpoint, {state['retries']} retries so far", None)
        elif now - state["seen_at"] < IDLE_AFTER / 2:
            # Not the word used for a thinking block: that label carries the worker's own
            # words, and this line carries none. A reader must be able to tell a thought
            # from a report that there is no thought yet.
            say("waiting", f"no step for {fmt_elapsed(quiet)}, thinking", None)
        else:
            say("waiting", f"alive, but nothing new for {fmt_elapsed(quiet)}", None)
    if not alive():
        time.sleep(3)   # it may still be writing
        break
    if waited >= limit:
        break
    time.sleep(1)
    waited += 1

if not landed():
    if os.path.exists(stopped):
        rec = dict(l.strip().split("=", 1) for l in open(stopped) if "=" in l)
        print(f"this run was stopped on purpose with haring-kill at {rec.get('at', '?')} "
              f"by {rec.get('user', '?')}.", file=sys.stderr)
        print("Its work ends where it had got to. Read the progress and the events it",
              file=sys.stderr)
        print("before you build on any of it.", file=sys.stderr)
    elif alive():
        print(f"still running after {waited}s. The process is alive.", file=sys.stderr)
    else:
        print("the worker has gone and left no report. Read the progress and the tree before",
              file=sys.stderr)
        print("you believe anything about this run.", file=sys.stderr)
    if os.path.exists(progress) and os.path.getsize(progress):
        print("--- progress ---", file=sys.stderr)
        print(open(progress).read(), file=sys.stderr)
    sys.exit(3)

# A wait that joined after the run finished has read nothing live; this replay is what it
# shows instead, with the time each call was made taken from the events themselves.
if os.path.exists(events):
    steps(events, pos, seen, state)

stats = os.path.join(run, "stats.txt")
if os.path.exists(stats) and os.path.getsize(stats):
    sys.stdout.write(open(stats).read())
else:
    subprocess.run([os.path.join(HARING, "bin", "haring-stats"), run])
print()
# Flush before handing the terminal to another program: what this script has written is
# still in Python's buffer when stdout is a pipe, and the child writes to the file
# descriptor directly, so without this the report prints above the numbers.
sys.stdout.flush()
rc = subprocess.run([os.path.join(HARING, "bin", "haring-report"), run]).returncode
err = os.path.join(run, "stderr.txt")
if os.path.exists(err) and os.path.getsize(err):
    print("\n--- stderr ---")
    sys.stdout.write(open(err).read())
sys.exit(rc)
