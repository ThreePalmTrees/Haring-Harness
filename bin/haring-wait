#!/bin/sh
# haring-wait — wait for a worker, then print what it returned.
#
#   haring-wait <run-folder> [max-seconds]
#
# Exits 0 when the worker reported, and 1 when it left a report that cannot be read.
# Exits 2 when it was called wrongly: no arguments, or a path that is not a haring
# run folder. One exit is neither of those, and it is the interesting one:
#
#   3   the worker has gone and left no report at all
#
# It means "no report, but there may be work on disk", and it prints the progress file
# so the next reader starts from something real.
#
# Waits while the worker process is alive. A clock alone is the wrong test: real work
# has run for twenty-seven minutes, and a fixed time limit only makes the manager restart
# the wait, which costs a round trip and tells it nothing.
set -e
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: haring-wait <run-folder> [max-seconds]" >&2; exit 2; }
run=${1%/}
limit=${2:-7200}
case "$limit" in ''|*[!0-9]*)
  echo "max-seconds must be a number, got: $limit" >&2; exit 2 ;; esac
# A run folder is known by its meta file, the same marker `haring-worker continue`
# uses. Without this check an ordinary directory reaches the sed below, which fails on
# the missing meta and kills the script under set -e with no word of why.
[ -f "$run/meta" ] || { echo "not a haring run folder: $run" >&2; exit 2; }

pid=$(sed -n 's/^pid=//p' "$run/meta" 2>/dev/null)
waited=0
while [ ! -s "$run/report.json" ]; do
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    sleep 3   # it may still be writing
    break
  fi
  [ "$waited" -ge "$limit" ] && break
  sleep 5
  waited=$((waited + 5))
done

if [ ! -s "$run/report.json" ]; then
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "still running after ${waited}s. The process is alive." >&2
  else
    echo "the worker has gone and left no report. Read the progress and the tree before" >&2
    echo "you believe anything about this run." >&2
  fi
  [ -s "$run/PROGRESS.md" ] && { echo "--- progress ---" >&2; cat "$run/PROGRESS.md" >&2; }
  exit 3
fi

cat "$run/stats.txt" 2>/dev/null || "$HARING/bin/haring-stats" "$run"

echo
"$HARING/bin/haring-report" "$run"
if [ -s "$run/stderr.txt" ]; then echo; echo "--- stderr ---"; cat "$run/stderr.txt"; fi
