#!/bin/sh
# haring-worker — start one worker, or continue one you already started.
# Always in the background; prints the run folder, and on standard error the pulse
# that follows it.
#
#   haring-worker <kind> <workdir> <prompt-file> [--model M] [--effort L] [--no-pulse]
#   haring-worker continue <kind> <previous-run-folder> <prompt-file>
#
# kind is one of: check implement errand
#
# The model is glm-5.3-flash for every kind. The manager never chooses another one.
# --model exists only for when the person who asked for the work asks for it.
# --effort lowers or raises how hard the worker thinks, and exists only for when the
# person who asked for the work asks for it. No kind sets it: see the comment above
# the kind table.
# --no-pulse starts a run without a live haring-pulse watching the project, which
# otherwise is refused. It is consumed here and never reaches the worker.
set -e

# Resolve our own real location, following symlinks, so this keeps working when
# it is linked onto PATH by install.sh.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

MODEL_DEFAULT=glm-5.3-flash

# The most workers that may run at once in one project, and only when HARING_ALLOW_PARALLEL
# is set. The number is the plan's concurrency limit — the most requests the model provider
# allows in flight at the tier being paid for — and not a guess about the machine: one over
# it is a rate-limit failure in every worker already going. Raising it is one edit here.
MAX_PARALLEL_WORKERS=2

# A worker holds a shell, and every haring command is on PATH, so this script is one a
# worker can call exactly as the manager does. It is refused. Only the manager decides to
# spend money on another run: spending on a nested run never appears in the parent run's
# own numbers, every worker competes for the same request limit, and a worker is the same
# kind of thing as the one that started it, so without this there is nothing to stop a
# worker starting workers starting workers.
#
# The check is the marker HARING_NESTED, which the haring-worker that started this worker
# put in its environment, below. It travels from there through run.sh into claude and into
# every shell command the worker runs, so there is no route round it: calling the script
# through sh, or by its full path, ends here all the same.
if [ -n "$HARING_NESTED" ]; then
  echo "haring-worker: refused — you are inside a worker ($HARING_NESTED), and workers do" >&2
  echo "  not start workers. Only the manager decides to spend on another run." >&2
  echo "  Instead: say in your report that verification needs one, name the exact command" >&2
  echo "  you would have run, and put every claim that depends on it in the did_not_check" >&2
  echo "  doubt list rather than reporting it as verified." >&2
  exit 2
fi

usage() {
  echo "usage: haring-worker <kind> <workdir> <prompt-file> [--model M] [--effort L] [--no-pulse]" >&2
  echo "       haring-worker continue <kind> <previous-run-folder> <prompt-file>" >&2
  exit 2
}

# ---------------------------------------------------------------- continue mode
# Continuing keeps the worker's context, which is worth real money: a continued worker read
# 180 fresh input tokens where a new one read 12,527.
#
# The kind is named again on every continue because the kind is what sets the tools, and
# tools are chosen at each launch rather than fixed when a session begins. So the kind may
# differ from the one the run started as: a worker that checked a claim can be continued
# as one that implements, and it keeps everything it learned while checking.
#
# A continued run forks. It resumes the previous conversation under a session id of its own,
# so the run it came from keeps its transcript whole and can be continued again.
resume_id=""
if [ "$1" = "continue" ]; then
  kind=$2; prev=$3; promptfile=$4
  [ -n "$kind" ] && [ -n "$prev" ] && [ -n "$promptfile" ] || usage
  [ -f "$prev/meta" ] || { echo "no meta in $prev — not a haring run folder" >&2; usage; }
  # These two are real failures of the previous run, not a mistyped command: the
  # folder named is a haring run and there is nothing in it to continue from.
  [ -s "$prev/report.json" ] || {
    echo "$prev has no report. A worker that never reported cannot be continued." >&2
    echo "Read its PROGRESS.md and its transcript, then start a fresh one." >&2; exit 1; }
  resume_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("session_id") or "")' "$prev/report.json")
  [ -n "$resume_id" ] || { echo "no session_id in $prev/report.json" >&2; exit 1; }
  # workdir and model come from the run being continued; the kind comes from the caller.
  want_kind=$kind
  # shellcheck disable=SC1090
  . "$prev/meta"
  kind=$want_kind
  shift 4
else
  kind=$1; workdir=$2; promptfile=$3
  [ -n "$kind" ] && [ -n "$workdir" ] && [ -n "$promptfile" ] || usage
  shift 3
  model=""
fi

[ -f "$promptfile" ] || { echo "no such prompt file: $promptfile" >&2; exit 2; }

no_pulse=""
effort=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) [ $# -ge 2 ] && [ -n "$2" ] || usage; model=$2; shift 2
             echo "haring-worker: WARNING — model overridden to '$model'." >&2
             echo "  The manager must not do this on its own. Only do it when the person" >&2
             echo "  who asked for the work asked for it." >&2 ;;
    --effort) [ $# -ge 2 ] && [ -n "$2" ] || usage; effort=$2; shift 2
             case "$effort" in
               low|medium|high|xhigh|max) ;;
               *) echo "haring-worker: unknown effort level: $effort" >&2
                  echo "  The tool takes: low, medium, high, xhigh, max." >&2
                  usage ;;
             esac ;;
    --no-pulse) no_pulse=1; shift ;;
    *) echo "haring-worker: unknown argument: $1" >&2; usage ;;
  esac
done

: "${model:=$MODEL_DEFAULT}"

# The tools each kind may use, and the tools it is denied. A read-only kind gets a shell
# because reading needs one, and has the writing tools denied rather than being talked
# out of them by its rules.
#
# No kind sets --effort. Measured: at --effort low a single-fact extraction ran twice as
# fast and stayed correct, but a multi-part task came back in 179 characters where the
# task cannot be answered under 3000 — the low runs returned nothing having done nothing —
# and a real errand at low returned an empty result with no tool call at all. Half the
# time is not worth any chance of no answer, so effort stays the tool's default unless
# the caller passes --effort above.
#
# There is no spending limit. A limit that fires returns NO REPORT AT ALL: the work is on
# disk, unverified, with no account of itself, which is worse than any run it would have
# stopped. A run that goes wrong is caught by reading its progress file, not by killing it.
case "$kind" in
  check)
      tools='Read,Glob,Grep,Bash'; denied='Write,Edit'
      extra='--bare' ;;
  errand)
      tools='Read,Glob,Grep'; denied='Bash,Write,Edit'
      extra='--bare' ;;
  implement)
      tools='Read,Write,Edit,Glob,Grep,Bash'; denied=''
      extra='--permission-mode acceptEdits' ;;
  *) echo "unknown kind: $kind" >&2; usage ;;
esac
[ -n "$effort" ] && extra="$extra --effort $effort"

# Checked here, after the kind, so both modes are covered: in continue mode the
# workdir comes out of the previous run's meta.
[ -d "$workdir" ] || { echo "no such workdir: $workdir" >&2; usage; }

# The project is the git top level of the workdir when there is one, else the workdir.
project=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null || echo "$workdir")

# A run nobody is watching is a run the manager hears nothing about: haring-pulse prints
# one line per live worker, and starting it is the rule the manager was told to follow
# and forgot, six runs running, one of them over half an hour in silence. So the pulse is
# required here rather than remembered, before anything is created. The pulse writes its
# own pid into <project>/.haring/pulse while it lives and removes it on the way out, so
# the test is the pid the file names being alive: a file left by a pulse killed hard is
# not a pulse, and the refusal says so rather than taking the file as the guarantee.
# --no-pulse lifts the check for one launch, as HARING_ALLOW_PARALLEL does; it is
# consumed here and never reaches the worker or its environment.
if [ -z "$no_pulse" ]; then
  pulse_file="$project/.haring/pulse"
  why=""
  if [ ! -f "$pulse_file" ]; then
    why="no haring-pulse is watching this project: there is no $pulse_file"
  else
    pulse_pid=$(cat "$pulse_file" 2>/dev/null) || true
    case "$pulse_pid" in
      '') why="$pulse_file gave no process id" ;;
      *[!0-9]*) why="$pulse_file holds '$pulse_pid', which is not a process id" ;;
      *) kill -0 "$pulse_pid" 2>/dev/null || why="the pulse that wrote $pulse_file is gone: pid $pulse_pid is not alive — a pulse killed hard is not a pulse" ;;
    esac
  fi
  if [ -n "$why" ]; then
    echo "haring-worker: refused — nobody is watching this run. haring-pulse prints one" >&2
    echo "  line per live worker, and a run started without one runs in silence until" >&2
    echo "  someone asks what is happening." >&2
    echo "  $why" >&2
    echo "  Watch it as it goes: haring-pulse $project" >&2
    exit 2
  fi
fi

# One worker at a time in a project. The manager's own rules say this and broke it anyway,
# so the limit lives here, next to the nesting guard above, where a rule becomes something
# that answers back. Live is decided exactly as haring-pulse decides it: a run whose meta
# names a pid that is still alive and whose report.json is still empty. Sitting here the
# test reads only runs already on disk, and refuses before the .gitignore below or the run
# folder below that is written, so a refused start leaves nothing behind.
#
# HARING_ALLOW_PARALLEL lifts it for one launch, as HARING_ALLOW_NESTING does, up to
# MAX_PARALLEL_WORKERS: the plan's concurrency limit, which holds even under the lift. It
# is unset rather than passed on, so a worker started under it carries no lift of its own.
live=""
live_count=0
for meta in "$project"/.haring/runs/*/meta; do
  [ -f "$meta" ] || continue
  run_dir=${meta%/meta}
  pid=$(sed -n 's/^pid=//p' "$meta")
  case "$pid" in ''|*[!0-9]*) continue ;; esac
  kill -0 "$pid" 2>/dev/null || continue
  [ -s "$run_dir/report.json" ] && continue
  live_count=$((live_count + 1))
  live="$live
$run_dir"
done
if [ -n "$live" ] && [ -z "$HARING_ALLOW_PARALLEL" ]; then
  echo "haring-worker: refused — another worker is already going in this project, and" >&2
  echo "  only one runs at a time." >&2
  printf '%s\n' "$live" | sed '/^$/d' | while IFS= read -r other; do
    echo "  $other" >&2
    echo "    stop it with: haring-kill $other" >&2
  done
  echo "  When two at once is genuinely right, start this one with" >&2
  echo "  HARING_ALLOW_PARALLEL set, as the nesting lift is set." >&2
  exit 2
fi
if [ "$live_count" -ge "$MAX_PARALLEL_WORKERS" ]; then
  echo "haring-worker: refused — HARING_ALLOW_PARALLEL is set, and the ceiling still" >&2
  echo "  holds: $MAX_PARALLEL_WORKERS workers at once is what the plan allows, and" >&2
  echo "  $live_count are already going in this project." >&2
  printf '%s\n' "$live" | sed '/^$/d' | while IFS= read -r other; do
    echo "  $other" >&2
    echo "    stop it with: haring-kill $other" >&2
  done
  exit 2
fi
unset HARING_ALLOW_PARALLEL

# Run records are haring's, not the project's, so keep them out of its history. Done once,
# the first time haring writes into a repository, and said out loud.
if [ ! -d "$project/.haring" ] && git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
  if ! grep -qxF '.haring/' "$project/.gitignore" 2>/dev/null; then
    printf '.haring/\n' >> "$project/.gitignore"
    echo "haring: added '.haring/' to $project/.gitignore so run records stay out of your history." >&2
  fi
fi

# A unique folder every time. The pid is there because seconds are not enough on their own:
# two workers started in the same second would otherwise share a folder.
run="$project/.haring/runs/$(date +%Y-%m-%d-%H%M%S)-$kind-$$"
mkdir -p "$run"

# Name the session ourselves. Claude writes each transcript under the session id, so
# naming it here puts the run's transcript in the run's meta, and haring-session can
# tell a worker from the manager without guessing from what the worker did last.
session=$(python3 -c 'import uuid; print(uuid.uuid4())')

{
  echo "kind=$kind"
  echo "workdir='$workdir'"
  echo "model=$model"
  echo "session_id=$session"
} > "$run/meta"
[ -n "$resume_id" ] && { echo "resumed_from='$prev'" >> "$run/meta"; echo "resumed_session='$resume_id'" >> "$run/meta"; }

# The prompt the worker actually receives: the task, and — for every kind but errand —
# where to write progress and what the first line of it must be. The method line is what
# the manager reads inside the first minute, so a worker that means to spend eleven
# minutes driving a browser over a two-file question is visible while stopping is cheap.
# An errand is asked for none of it because it holds neither Write nor a shell, and so
# could not keep the file at all. This is the only copy of the question, so it is the one
# file in the run folder that cannot be regenerated.
{
  cat "$promptfile"
  case "$kind" in
    implement|check)
      : > "$run/PROGRESS.md"
      printf '\n\n---\nWrite your progress to this exact path, one line at a time: %s\n' "$run/PROGRESS.md"
      printf 'Your first line is the method — how you intend to answer this, in one\n'
      printf 'sentence — written before you do anything else, so the manager can stop\n'
      printf 'you while stopping is still cheap.\n' ;;
  esac
} > "$run/prompt.md"

# The private paths every worker is refused, of every kind, whatever it was asked: Claude
# Code's own transcripts and memory, private keys, cloud credentials, shell history.
deny_entries='      "Read(~/.claude/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)"'

# A worker sent to a project other than haring's own repository is refused haring's source
# as well: the repository holds every script, rule and schema haring is, and it is reachable
# again through the links install.sh puts in ~/.local/bin. The skill link in ~/.claude/skills
# needs no entry of its own: it is inside ~/.claude, which the first entry already names, and
# the files it points at are inside the repository, which the repository entry names. Left
# out when the worker was sent to haring, which has to be able to read and change itself.
#
# Why these four entries and not fewer or different ones, all measured rather than assumed:
# a Read rule holds the Read tool and a shell command alike, and it holds them through a
# symlink, so the repository entry alone already covers a command naming an installed link.
# It does not hold a command that writes — that is what the Edit rule is for, since a Write
# rule is ignored by the shell check and Edit is the rule the harness applies to a command
# that creates, changes or removes a file. And only the ~ form is applied to shell commands
# at all: the same rule written with an absolute path never fires there, which is why the
# repository is spelled with ~ and why a repository outside $HOME gets the absolute form as
# a best effort, holding the Read tool but not known to hold the shell.
haring_real=$(CDPATH= cd -- "$HARING" && pwd -P)
project_real=$(CDPATH= cd -- "$project" && pwd -P)
if [ "$project_real" != "$haring_real" ]; then
  case "$haring_real" in
    "$HOME")   haring_home="~" ;;
    "$HOME"/*) haring_home="~/${haring_real#"$HOME"/}" ;;
    *)         haring_home="$haring_real" ;;
  esac
  deny_entries="$deny_entries$(printf ',\n      "Read(%s/**)"' "$haring_home")"
  deny_entries="$deny_entries$(printf ',\n      "Edit(%s/**)"' "$haring_home")"
  deny_entries="$deny_entries,
      \"Read(~/.local/bin/haring-*)\",
      \"Edit(~/.local/bin/haring-*)\""
fi

# Written into the run folder and handed to Claude Code with --settings, so the refusal
# comes from the harness and not from the worker's own good behaviour. A deny rule names a
# path, and Claude Code checks that path against shell commands as well as against the Read
# tool — which is why a worker holding a shell is held by this list too.
cat > "$run/settings.json" <<DENIED
{
  "permissions": {
    "deny": [
$deny_entries
    ]
  }
}
DENIED

# The endpoint and token, unless the caller has already chosen them. An override
# is what lets workers run through a local gateway when the plan quota is spent.
ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN:-$(security find-generic-password -a "$USER" -s haring-zai -w)}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-https://api.z.ai/api/anthropic}
export ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL

# Every worker this script starts is marked, so that haring-worker and haring-kill refuse
# if it tries to start or stop a run of its own. HARING_ALLOW_NESTING lifts that for one
# launch: the manager sets it on the way in, and this worker alone is left unmarked and so
# may start workers. The lift is consumed rather than passed on — it is taken off the
# environment this worker inherits — so the workers it starts are marked like any other,
# and the recursion stops at the one level the manager asked for.
if [ -n "$HARING_ALLOW_NESTING" ]; then
  unset HARING_ALLOW_NESTING
else
  export HARING_NESTED="$run"
fi

schema="$HARING/schemas/$kind.json"
# Assembled in memory. It is the same 15KB for every run of a kind, so it is not copied into
# the run folder; regenerate any run's rules with `haring-prompt <kind>`.
sysprompt=$("$HARING/bin/haring-prompt" "$kind")
# Every run gets its own session id, minted above and recorded in its meta, so every run has
# a transcript of its own that haring-session can tell apart from the manager's. A continued
# run adds --fork-session, which is what makes the resumed conversation land under this run's
# id instead of writing back into the one it came from.
resume_flag=""
[ -n "$resume_id" ] && resume_flag="--resume $resume_id --fork-session"

# The worker runs as its own session, not merely in the background. A background child
# stays in its launcher's process group, so anything that kills that group — a tool
# timeout, a cancelled command — kills the worker too, and it dies leaving an empty
# report. Detaching properly is the only way a long run survives the thing that started it.
#
# The three redirections on the python call are load-bearing. A detached grandchild inherits
# whatever descriptors it is handed, and if it keeps the caller's stdout then
# `run=$(haring-worker ...)` never returns: command substitution waits for that pipe to close
# and the pipe stays open until the worker finishes. Every launch would block for the whole
# run.
# stdout is the event stream, not the report. stream-json writes each event on its own
# line the moment it happens, which is the record haring owns: Claude Code's transcript
# lives at a path nothing promises, and when it moved, every command watching a run went
# blind while the worker carried on. The stream's last result event holds every field the
# old --output-format json printed, so report.json is rebuilt from it below and stays the
# file the other commands already read. --verbose is not optional: stream-json under -p
# refuses to start without it.
#
# report.json is emptied here rather than left to the extractor. A file absent until the
# end is a run that looks unfinished the whole time it runs; an empty one is what
# haring-wait and haring-pulse already treat as "not landed yet", and what a killed worker
# leaves behind.
# claude reads its input from a pipe rather than from nothing, so that a word said to a
# running worker can reach it: --input-format stream-json makes it read user messages
# from stdin while it works, and the task itself travels over that pipe as the first of
# them. Holding the pipe open for the life of the run is the keeper written just below —
# it is the only thing holding it, so a keeper that dies ends the run instead of hanging
# it, and it closes the pipe itself once claude has answered everything it was sent.
# The denied list travels as --disallowedTools only when the kind denies something: the
# run.sh heredoc expands parameters but does not split words, so an empty value written
# straight into it would leave the bare flag holding the next argument as its list.
denied_flag=''
if [ -n "$denied" ]; then denied_flag="--disallowedTools $denied"; fi
cat > "$run/run.sh" <<RUNNER
#!/bin/sh
echo "pid=\$\$" >> "$run/meta"
cd "$workdir" || exit 1
: > "$run/report.json"
cat > "$run/keeper.tmp" <<'KPIPE'
import json, os, select, signal, sys, time

# Holds the writing end of the pipe claude reads its input from. The task itself is the
# first thing over that pipe — a line written before claude is up reading waits in the
# pipe for it, as a pipe does — and everything the manager says later with haring-say
# goes over the same one, appended to say.jsonl in the run folder. A message is handed
# over only once everything before it has been answered, because claude reads its input
# between turns: one written mid-turn sat unread for the rest of the run, where one
# written after a result starts the next turn and gets its own. When claude has answered
# everything handed to it, the pipe is closed, which is how an unsteered run ends exactly
# when it always did and a steered one ends once it has answered.
#
# This process is the only holder of the pipe, on purpose. If it dies for any reason the
# pipe closes with it, claude reads end of input and finishes the turn it is on rather
# than waiting forever for a message that will never come. The other half of that is
# watched the same way: claude can end while a message is still owed — a crash, or a
# turn that was its last — and a write end held to a pipe nobody reads would hang the
# whole run, so the reader's side of the pipe is polled, and its going is the end too.

run = sys.argv[1]
limit = int(sys.argv[2])                 # seconds of no new event before the run stops
queue = os.path.join(run, "say.jsonl")   # haring-say appends one line per message
state = os.path.join(run, "say.state")   # who is listening, and how much it has taken
events = os.path.join(run, "events.jsonl")

reader = select.poll()
reader.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP | select.POLLNVAL)


def reader_gone():
    return bool(reader.poll(0))


def added(path, pos):
    """Complete lines appended at path since pos, and the position to read from next."""
    out = []
    if os.path.exists(path):
        with open(path) as f:
            f.seek(pos)
            rest = f.read()
        while True:
            cut = rest.find("\n")
            if cut < 0:
                break
            out.append(rest[:cut])
            rest = rest[cut + 1:]
            pos += cut + 1
    return out, pos


def mark(handed, written):
    if handed == written:
        return written
    tmp = state + ".tmp"
    with open(tmp, "w") as f:
        f.write("pid=%d\nhanded=%d\n" % (os.getpid(), handed))
    os.replace(tmp, state)
    return handed


def counted(lines):
    """How many of these lines are answers."""
    answers = 0
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") == "result":
            answers += 1
    return answers


def stamped(lines):
    """Whether any of these lines carries a timestamp, which only real message events do."""
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if "timestamp" in d:
            return True
    return False


def hand_over(text):
    sys.stdout.write(json.dumps({"type": "user",
                                 "message": {"role": "user", "content": text}}) + "\n")
    sys.stdout.flush()


qpos = epos = consumed = sent = results = 0
handed = None   # nothing written to disk yet; the first mark is the first write
pending = []
caught_up = False
last_grew = time.time()   # silence is measured from message events, not from every line
try:
    with open(os.path.join(run, "prompt.md")) as f:
        pending.append(f.read())
    while True:
        lines, qpos = added(queue, qpos)
        for line in lines:
            consumed += 1
            try:
                text = json.loads(line).get("content")
            except ValueError:
                text = None
            if isinstance(text, str) and text.strip():
                pending.append(text)
        # Idle means every message so far has its result, so the next one starts a turn
        # of its own. The task itself goes over by the same rule, before any result.
        if pending and results >= sent:
            hand_over(pending.pop(0))
            sent += 1
        # Handed is what haring-say watches for: how many of the queue's messages have
        # actually reached claude, which is one behind sent until the task is in.
        handed = mark(max(0, sent - 1), handed)
        lines, epos = added(events, epos)
        results += counted(lines)
        if stamped(lines):
            last_grew = time.time()
        if reader_gone():
            break
        if time.time() - last_grew >= limit:
            # The endpoint has stopped answering: no message event has carried a
            # timestamp for the limit, and claude would sit here writing api_retry events
            # forever, since its retry counter starts over on every request. api_retry and
            # thinking_tokens carry no timestamp, because they are written while nothing
            # is arriving, and resetting on them would keep a failing run alive
            # indefinitely. The keeper is the one thing that
            # lives exactly as long as the run, so the stop is made from inside it. The
            # file is written before the group is signalled, because this keeper is inside
            # the group and will not survive the signal; haring-wait reads the file to
            # report a stall instead of a worker that vanished.
            with open(os.path.join(run, "stalled"), "w") as f:
                f.write("at=%s\n" % time.strftime("%Y-%m-%dT%H:%M:%S"))
                f.write("silent=%d\n" % (time.time() - last_grew))
            os.killpg(os.getpgrp(), signal.SIGKILL)
        if results >= sent and not pending:
            # One more turn of the loop before closing, so a message handed over in the
            # same breath as the answer is still owed its answer.
            if caught_up:
                break
            caught_up = True
        else:
            caught_up = False
        time.sleep(0.2)
except BrokenPipeError:
    pass
finally:
    try:
        sys.stdout.close()
    except OSError:
        pass
    try:
        os.remove(state)
    except OSError:
        pass
KPIPE
# 900 is fifteen minutes of silence, after which the run stops itself and leaves a
# stalled file. The longest silence any run here has recorded is 7.0 minutes and every
# run near it finished with a report, so a run quiet for twice that is not working. The
# limit travels as an argument so it can be tested in seconds rather than minutes.
python3 "$run/keeper.tmp" "$run" 900 | claude -p \
  --model "$model" \
  --session-id "$session" \
  --append-system-prompt "\$(cat "$run/system.tmp")" \
  --allowedTools "$tools" \
  $denied_flag \
  --output-format stream-json --input-format stream-json --verbose \
  --json-schema "\$(cat "$schema")" \
  --settings "$run/settings.json" \
  $extra $resume_flag \
  2>&1 1> "$run/events.jsonl" \
  | grep -v "unrecognized_model" \
  | grep -v "claude.ai connectors are disabled" > "$run/stderr.txt"
[ -s "$run/stderr.txt" ] || rm -f "$run/stderr.txt"
# The last result event is the report. There can be more than one in a stream, and the
# last is the one that says how the run ended. A stream with none — a killed worker, a
# claude that never started — leaves report.json as the empty file it was, which is the
# signal haring-wait's exit 3 and the stopped marker of haring-kill both hang off.
python3 -c '
import json, sys
events, report = sys.argv[1], sys.argv[2]
found = None
for line in open(events):
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
    except ValueError:
        continue
    if d.get("type") == "result":
        found = d
if found is not None:
    with open(report, "w") as f:
        json.dump(found, f, indent=2)
        f.write("\n")
' "$run/events.jsonl" "$run/report.json"
"$HARING/bin/haring-stats" "$run" > "$run/stats.txt" 2>/dev/null || true
rm -f "$run/system.tmp" "$run/keeper.tmp" "$run/run.sh"
RUNNER
chmod +x "$run/run.sh"
printf '%s' "$sysprompt" > "$run/system.tmp"

python3 -c '
import os, sys, subprocess
if os.fork() > 0: os._exit(0)      # leave the caller
os.setsid()                        # become our own session, out of the group
if os.fork() > 0: os._exit(0)      # never reacquire a terminal
subprocess.run(["/bin/sh", sys.argv[1]],
               stdin=subprocess.DEVNULL,
               stdout=subprocess.DEVNULL,
               stderr=subprocess.DEVNULL)
' "$run/run.sh" </dev/null >/dev/null 2>&1

# The runner records its own pid, so give it a moment to appear.
i=0
while [ ! -s "$run/meta" ] || ! grep -q '^pid=' "$run/meta"; do
  i=$((i + 1)); [ "$i" -gt 50 ] && break
  sleep 0.1
done

# Nothing else names the pulse, and three runs in a row went unwatched for it. The
# moment a manager would start one is this one: it is reading this launch's output, and
# the pulse it starts here covers the run it is about to read.
echo "haring: watch it as it goes — haring-pulse $project" >&2
echo "$run"
