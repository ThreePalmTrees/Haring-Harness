#!/bin/sh
# haring-worker — start one worker, or continue one you already started.
# Always in the background; prints the run folder, and on standard error the pulse
# that follows it.
#
#   haring-worker <kind> <workdir> <prompt-file> [--model M] [--effort L] [--no-pulse]
#   haring-worker continue <kind> <previous-run-folder> <prompt-file>
#
# kind is one of: check implement errand qa
#
# The worker is an OpenCode session, started by workers/opencode/start, on one of the
# models named in the worker's worker.conf. Absent --model, it settles from <project>/.haring/model, then
# <haring-root>/model, then the default in workers/opencode/worker.conf, read and
# written by haring-model. The manager never chooses a model
# on its own: --model exists only for when the person who asked for the work asks for it.
# A qa run settles differently: a QA pass runs on opus as the Claude Code agent
# haring-qa unless the client chose an OpenCode model for it, so a fresh qa run takes
# its model from <project>/.haring/qa-model, then <haring-root>/qa-model, both read and
# written by haring-model --qa, and refuses — pointing at the agent — when neither
# names an OpenCode model. --model overrides with the same warning as any kind; a
# continue keeps the run's own model.
# --effort lowers or raises how hard the worker thinks — low, high or max, the model's
# OpenCode variant — and exists only for when the person who asked for the work asks
# for it. No kind sets it: see the comment above the kind table.
# --no-pulse starts a run without a live haring-pulse watching the project, which
# otherwise is refused. It is consumed here and never reaches the worker.
set -e

# Resolve our own real location, following symlinks, so this keeps working when
# it is linked onto PATH by install.sh.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

# The worker harness a fresh run uses. workers/<name>/ holds the programs that launch it
# and talk to it; a continue keeps the worker of the run it continues.
WORKER_DEFAULT=opencode

# The most workers that may run at once in one project, and only when HARING_ALLOW_PARALLEL
# is set. The number is the plan's concurrency limit — the most requests the model provider
# allows in flight at the tier being paid for — and not a guess about the machine: one over
# it is a rate-limit failure in every worker already going. Raising it is one edit here.
MAX_PARALLEL_WORKERS=2

# The most workers one worker may start. It is 0, and 0 means a worker starts none: the
# guard below refuses a caller marked as a worker. Raising it is how the idea of a worker
# starting its own helpers gets tested — one edit here, and nothing else.
MAX_NESTED_WORKERS=0

# A worker holds a shell, and every haring command is on PATH, so this script is one a
# worker can call exactly as the manager does. The guard below holds while
# MAX_NESTED_WORKERS is 0. Only the manager decides to spend money on another run:
# spending on a nested run never appears in the parent run's own numbers, every worker
# competes for the same request limit, and a worker is the same kind of thing as the one
# that started it, so at 0 there is nothing to stop a worker starting workers starting
# workers.
#
# The check is the marker HARING_NESTED, which the haring-worker that started this worker
# put in its environment, below. It travels from there through run.sh into opencode, which
# hands its environment to the session in the OpenCode server, and so into
# every shell command the worker runs, so there is no route round it: calling the script
# through sh, or by its full path, ends here all the same.
#
# Above 0 the guard lets a marked caller through, and what it does not have yet is the
# count the number then needs: the live runs whose meta records this run under started_by,
# refused when they reach MAX_NESTED_WORKERS. None of that is built while the number is 0.
if [ -n "$HARING_NESTED" ] && [ "$MAX_NESTED_WORKERS" -eq 0 ]; then
  echo "haring-worker: refused — you are inside a worker ($HARING_NESTED), and workers do" >&2
  echo "  not start workers. Only the manager decides to spend on another run." >&2
  echo "  Instead: say in your report that verification needs one, name the exact command" >&2
  echo "  you would have run, and put every claim that depends on it in the did_not_check" >&2
  echo "  doubt list rather than reporting it as verified." >&2
  exit 2
fi

usage() {
  echo "usage: haring-worker <kind> <workdir> <prompt-file> [--model M] [--effort L] [--no-pulse]" >&2
  echo "       haring-worker continue <kind> <previous-run-folder> <prompt-file>" >&2
  exit 2
}

# ---------------------------------------------------------------- continue mode
# Continuing keeps the worker's context, which is worth real money: a continued worker read
# 180 fresh input tokens where a new one read 12,527.
#
# The kind is named again on every continue because the kind is what sets the tools, and
# tools are chosen at each launch rather than fixed when a session begins. So the kind may
# differ from the one the run started as: a worker that checked a claim can be continued
# as one that implements, and it keeps everything it learned while checking.
#
# A continued run resumes the previous conversation. When its worker's worker.conf says
# fork=yes it does so under a session id of its own, so the run it came from keeps its
# transcript whole and can be continued again; otherwise it resumes the same session, and
# the two runs share that transcript. fork is a hint, so a missing line resumes.
resume_id=""
if [ "$1" = "continue" ]; then
  kind=$2; prev=$3; promptfile=$4
  [ -n "$kind" ] && [ -n "$prev" ] && [ -n "$promptfile" ] || usage
  # A run may be named as a folder, relative or absolute, or by a bare name under the
  # project's runs folder: the same rule as resolve_run in bin/haring-kill.
  while [ "${prev%/}" != "$prev" ]; do prev=${prev%/}; done
  if [ ! -d "$prev" ] || [ ! -f "$prev/meta" ]; then
    case "$prev" in
      */*) echo "not a haring run folder: $prev" >&2; usage ;;
      *)
        top=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null || :)
        runs=${top:-$(pwd)}/.haring/runs
        found=$runs/$prev
        [ -d "$found" ] && [ -f "$found/meta" ] || {
          echo "no run named $prev under $runs" >&2; usage; }
        prev=$found
        ;;
    esac
  fi
  # These two are real failures of the previous run, not a mistyped command: the
  # folder named is a haring run and there is nothing in it to continue from.
  [ -s "$prev/report.json" ] || {
    echo "$prev has no report. A worker that never reported cannot be continued." >&2
    echo "Read its PROGRESS.md and its transcript, then start a fresh one." >&2; exit 1; }
  resume_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("session_id") or "")' "$prev/report.json")
  [ -n "$resume_id" ] || { echo "no session_id in $prev/report.json" >&2; exit 1; }
  # workdir and model come from the run being continued; the kind comes from the caller.
  want_kind=$kind
  # shellcheck disable=SC1090
  . "$prev/meta"
  kind=$want_kind
  # A run recorded before meta named its worker continues on the default one.
  worker=${worker:-$WORKER_DEFAULT}
  shift 4
else
  kind=$1; workdir=$2; promptfile=$3
  [ -n "$kind" ] && [ -n "$workdir" ] && [ -n "$promptfile" ] || usage
  shift 3
  model=""
  worker=$WORKER_DEFAULT
fi

# The models a worker may run on, written the way `opencode run -m` takes them, live in
# the worker's own worker.conf: default_model= names the default and models= lists what
# may be chosen. A model outside the list is refused once the model settles, before
# anything is created. A worker with no readable list is refused here rather than left
# running on a name nothing checked.
worker_conf="$HARING/workers/$worker/worker.conf"
MODEL_DEFAULT=""
MODELS=""
if [ -r "$worker_conf" ]; then
  MODEL_DEFAULT=$(sed -n 's/^default_model=//p' "$worker_conf" | sed -n 1p)
  MODELS=$(sed -n 's/^models=//p' "$worker_conf" | sed -n 1p)
fi
if [ -z "$MODEL_DEFAULT" ] || [ -z "$MODELS" ]; then
  echo "haring-worker: the $worker worker has no model list: $worker_conf is missing or unreadable." >&2
  exit 1
fi
is_model() {
  case " $MODELS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

[ -f "$promptfile" ] || { echo "no such prompt file: $promptfile" >&2; exit 2; }

no_pulse=""
effort=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) [ $# -ge 2 ] && [ -n "$2" ] || usage; model=$2; shift 2
             echo "haring-worker: WARNING — model overridden to '$model'." >&2
             echo "  The manager must not do this on its own. Only do it when the person" >&2
             echo "  who asked for the work asked for it." >&2 ;;
    --effort) [ $# -ge 2 ] && [ -n "$2" ] || usage; effort=$2; shift 2
             case "$effort" in
               low|high|max) ;;
               *) echo "haring-worker: unknown effort level: $effort" >&2
                  echo "  The worker models take: low, high, max." >&2
                  usage ;;
             esac ;;
    --no-pulse) no_pulse=1; shift ;;
    *) echo "haring-worker: unknown argument: $1" >&2; usage ;;
  esac
done

# Checked here, before the model settles, because the project's own file is one of the
# places the model can come from: in continue mode the workdir comes out of the
# previous run's meta, and in a fresh run it is the caller's own argument.
[ -d "$workdir" ] || { echo "no such workdir: $workdir" >&2; usage; }

# The project is the git top level of the workdir when there is one, else the workdir.
project=$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null || echo "$workdir")

# The model settles from four places, the first that names one winning: --model above,
# then the project's own choice, then haring's, then the default. A continue never
# reaches here with an empty model — it already has one from the run it continues,
# sourced from "$prev/meta" above — so this is only for a fresh run without --model.
# A file that is missing, empty, or holds only whitespace names nothing and is passed
# over rather than treated as a choice or an error.
model_source=""
if [ "$kind" = qa ]; then
  # A QA pass runs only when the client asks for one, and by default on opus as the
  # Claude Code agent haring-qa, which the manager starts with its Agent tool — not
  # here. This script runs a QA only when the client chose an OpenCode model for it:
  # --model, or the qa-model files, the project's then haring's, read under the same
  # whitespace rule as the plain settle. Unset, opus or sonnet is the agent's to run,
  # and is refused with where to go instead. It sits here, before anything is created
  # and above the pulse check and the one-worker check, so it fires whatever else is
  # true about the project. A continue keeps the model of the run it continues.
  if [ -z "$model" ]; then
    for model_file in "$project/.haring/qa-model" "$HARING/qa-model"; do
      [ -f "$model_file" ] || continue
      candidate=$(tr -d '[:space:]' < "$model_file")
      [ -n "$candidate" ] || continue
      model=$candidate
      model_source=$model_file
      break
    done
  fi
  case "$model" in
    ''|opus|sonnet)
      echo "haring-worker: this QA runs on ${model:-opus}, as the Claude Code agent haring-qa." >&2
      echo "  Start it with the Agent tool (subagent_type haring-qa${model:+, model $model})." >&2
      echo "  haring-worker runs a QA only on an OpenCode model: haring-model --qa <model>." >&2
      exit 1 ;;
  esac
elif [ -z "$model" ]; then
  for model_file in "$project/.haring/model" "$HARING/model"; do
    [ -f "$model_file" ] || continue
    candidate=$(tr -d '[:space:]' < "$model_file")
    [ -n "$candidate" ] || continue
    model=$candidate
    model_source=$model_file
    break
  done
fi
: "${model:=$MODEL_DEFAULT}"

# A model the table above does not hold is refused here and now, before anything is
# created: OpenCode's own refusal to an unknown name arrives only after it has
# started, which here means after the run folder exists and the worker is launched —
# a dead run for a mistyped model. Like a bad kind, it is a wrongly written command,
# so it is answered before the environment is examined at all: above the pulse check
# and the one-worker check, which would each refuse first for its own reason and say
# nothing about the model.
if ! is_model "$model"; then
  echo "haring-worker: unknown model: $model" >&2
  [ -n "$model_source" ] && echo "  (from $model_source)" >&2
  echo "  haring-worker takes one of: $MODELS" >&2
  exit 2
fi

# Each kind runs as its own OpenCode agent, workers/opencode/agents/<kind>.md, linked
# into ~/.config/opencode/agents by workers/opencode/agents-config, which install.sh
# runs. The agent is where a kind's limits live: a deny rule there removes the tool
# from the session outright, so a read-only kind has no write tool to be talked out of.
# check and qa are denied edit (which covers write and patch too), errand is denied the
# shell as well, and every kind is denied question, subagent, skill, webfetch and
# websearch. The private paths every worker is refused are refused twice: to the read
# and edit tools by the global ~/.config/opencode/opencode.jsonc, and to the shell by
# the agents' own shell rules, which match the text of each command. Anything else
# outside the project is open to every tool — OpenCode allows external directories to
# these agents by default.
#
# No kind sets --effort. Measured: at --effort low a single-fact extraction ran twice as
# fast and stayed correct, but a multi-part task came back in 179 characters where the
# task cannot be answered under 3000 — the low runs returned nothing having done nothing —
# and a real errand at low returned an empty result with no tool call at all. Half the
# time is not worth any chance of no answer, so effort stays the tool's default unless
# the caller passes --effort above.
#
# There is no spending limit. A limit that fires returns NO REPORT AT ALL: the work is on
# disk, unverified, with no account of itself, which is worse than any run it would have
# stopped. A run that goes wrong is caught by reading its progress file, not by killing it.
case "$kind" in
  check|errand|implement|qa) ;;
  *) echo "unknown kind: $kind" >&2; usage ;;
esac
effort_arg=""
[ -n "$effort" ] && effort_arg="--effort $effort"
"$HARING/workers/$worker/agents-config" check "$kind" || exit 1

# A run nobody is watching is a run the manager hears nothing about: haring-pulse prints
# one line per live worker, and starting it is the rule the manager was told to follow
# and forgot, six runs running, one of them over half an hour in silence. So the pulse is
# required here rather than remembered, before anything is created. The pulse writes its
# own pid into <project>/.haring/pulse while it lives and removes it on the way out, so
# the test is the pid the file names being alive: a file left by a pulse killed hard is
# not a pulse, and the refusal says so rather than taking the file as the guarantee.
# --no-pulse lifts the check for one launch, as HARING_ALLOW_PARALLEL does; it is
# consumed here and never reaches the worker or its environment.
if [ -z "$no_pulse" ]; then
  pulse_file="$project/.haring/pulse"
  why=""
  if [ ! -f "$pulse_file" ]; then
    why="no haring-pulse is watching this project: there is no $pulse_file"
  else
    pulse_pid=$(cat "$pulse_file" 2>/dev/null) || true
    case "$pulse_pid" in
      '') why="$pulse_file gave no process id" ;;
      *[!0-9]*) why="$pulse_file holds '$pulse_pid', which is not a process id" ;;
      *) if ! kill -0 "$pulse_pid" 2>/dev/null; then
           why="the pulse that wrote $pulse_file is gone: pid $pulse_pid is not alive — a pulse killed hard is not a pulse"
         else
           case "$(ps -p "$pulse_pid" -o command= 2>/dev/null)" in
             *haring-pulse*) ;;
             *) why="the pulse that wrote $pulse_file is gone: pid $pulse_pid now belongs to another process" ;;
           esac
         fi ;;
    esac
  fi
  if [ -n "$why" ]; then
    echo "haring-worker: refused — nobody is watching this run. haring-pulse prints one" >&2
    echo "  line per live worker, and a run started without one runs in silence until" >&2
    echo "  someone asks what is happening." >&2
    echo "  $why" >&2
    echo "  Watch it as it goes: haring-pulse $project" >&2
    exit 2
  fi
fi

# One worker at a time in a project. The manager's own rules say this and broke it anyway,
# so the limit lives here, next to the nesting guard above, where a rule becomes something
# that answers back. Live is decided exactly as haring-pulse decides it: a run whose meta
# names a pid that is still alive, whose command names this run's folder, and whose
# report.json is still empty. The command matters because a freed pid is handed to
# whatever starts next, and a dead run read as live refuses a worker that should start.
# Sitting here the test reads only runs already on disk, and refuses before the .gitignore
# below or the run folder below that is written, so a refused start leaves nothing behind.
#
# HARING_ALLOW_PARALLEL lifts it for one launch, as HARING_ALLOW_NESTING does, up to
# MAX_PARALLEL_WORKERS: the plan's concurrency limit, which holds even under the lift. It
# is unset rather than passed on, so a worker started under it carries no lift of its own.
live=""
live_count=0
for meta in "$project"/.haring/runs/*/meta; do
  [ -f "$meta" ] || continue
  run_dir=${meta%/meta}
  pid=$(sed -n 's/^pid=//p' "$meta")
  case "$pid" in ''|*[!0-9]*) continue ;; esac
  kill -0 "$pid" 2>/dev/null || continue
  cmd=$(ps -p "$pid" -o command= 2>/dev/null) || continue
  case "$cmd" in *"${run_dir##*/}"*) ;; *) continue ;; esac
  [ -s "$run_dir/report.json" ] && continue
  live_count=$((live_count + 1))
  live="$live
$run_dir"
done
if [ -n "$live" ] && [ -z "$HARING_ALLOW_PARALLEL" ]; then
  echo "haring-worker: refused — another worker is already going in this project, and" >&2
  echo "  only one runs at a time." >&2
  printf '%s\n' "$live" | sed '/^$/d' | while IFS= read -r other; do
    echo "  $other" >&2
    echo "    stop it with: haring-kill $other" >&2
  done
  echo "  When two at once is genuinely right, start this one with" >&2
  echo "  HARING_ALLOW_PARALLEL set, as the nesting lift is set." >&2
  exit 2
fi
if [ "$live_count" -ge "$MAX_PARALLEL_WORKERS" ]; then
  echo "haring-worker: refused — HARING_ALLOW_PARALLEL is set, and the ceiling still" >&2
  echo "  holds: $MAX_PARALLEL_WORKERS workers at once is what the plan allows, and" >&2
  echo "  $live_count are already going in this project." >&2
  printf '%s\n' "$live" | sed '/^$/d' | while IFS= read -r other; do
    echo "  $other" >&2
    echo "    stop it with: haring-kill $other" >&2
  done
  exit 2
fi
unset HARING_ALLOW_PARALLEL

# Run records are haring's, not the project's, so keep them out of its history. Done once,
# the first time haring writes into a repository, and said out loud.
if [ ! -d "$project/.haring" ] && git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
  if ! grep -qxF '.haring/' "$project/.gitignore" 2>/dev/null; then
    printf '.haring/\n' >> "$project/.gitignore"
    echo "haring: added '.haring/' to $project/.gitignore so run records stay out of your history." >&2
  fi
fi

# A unique folder every time. The pid is there because seconds are not enough on their own:
# two workers started in the same second would otherwise share a folder.
run="$project/.haring/runs/$(date +%Y-%m-%d-%H%M%S)-$kind-$$"
mkdir -p "$run"

# The session is the worker's start program's to name: it chooses an id beginning ses_,
# writes it to the run's session file, and launches the harness with it. A continued run
# is resumed instead, forked when the worker's worker.conf says fork=yes, and only then
# is the id its fork picks the stream's to name.
{
  echo "kind=$kind"
  echo "workdir='$workdir'"
  echo "model=$model"
  echo "worker=$worker"
} > "$run/meta"
[ -n "$resume_id" ] && { echo "resumed_from='$prev'" >> "$run/meta"; echo "resumed_session='$resume_id'" >> "$run/meta"; }
# The run that started this one, when the caller was a worker. It is what counts children
# against MAX_NESTED_WORKERS; a run the manager started records nothing, having no parent.
[ -n "$HARING_NESTED" ] && echo "started_by='$HARING_NESTED'" >> "$run/meta"

# A continue asks its worker's start program to fork only when the worker.conf says it
# can. The line is a hint, so anything but yes — a missing file, a missing line, another
# value — resumes the same session rather than asking for a fork the harness may not have.
fork_arg=""
if [ -n "$resume_id" ] && python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import haring_events
sys.exit(0 if haring_events.worker_conf(sys.argv[2]).get("fork") else 1)' "$HARING/lib" "$run"; then
  fork_arg=--fork
fi

# The prompt the worker actually receives: the task, and — for every kind but errand —
# where to write progress and what the first line of it must be. The method line is what
# the manager reads inside the first minute, so a worker that means to spend eleven
# minutes driving a browser over a two-file question is visible while stopping is cheap.
# An errand is asked for none of it because it holds neither Write nor a shell, and so
# could not keep the file at all. This is the only copy of the question, so it is the one
# file in the run folder that cannot be regenerated.
# A fresh worker opens with the block bin/haring-meta prints: the project's name, the
# date, the operating system, whether the project is in git, and a listing of what it
# holds. It is the project the worker was sent to, so the worker gets it rather than
# spending its first turns gathering the same facts itself. A continued worker does not
# get it — it already has one from the run it continues. A project the block cannot
# describe is not a reason to refuse work, so a failure here leaves the prompt without
# it and the run goes ahead.
meta_block=""
if [ -z "$resume_id" ]; then
  meta_block=$("$HARING/bin/haring-meta" "$project" 2>/dev/null) || :
fi

{
  [ -z "$meta_block" ] || printf '%s\n' "$meta_block"
  # "Quick: " opens every prompt, fresh or continued; the manager never writes it.
  printf 'Quick: '
  cat "$promptfile"
  case "$kind" in
    implement|check|qa)
      : > "$run/PROGRESS.md"
      printf '\n\n---\nWrite your progress to this exact path, one line at a time: %s\n' "$run/PROGRESS.md"
      printf 'Your first line is the method — how you intend to answer this, in one\n'
      printf 'sentence — written before you do anything else, so the manager can stop\n'
      printf 'you while stopping is still cheap.\n' ;;
  esac
} > "$run/prompt.md"

# Every worker this script starts is marked, so that haring-worker and haring-kill refuse
# if it tries to start or stop a run of its own. HARING_ALLOW_NESTING lifts that for one
# launch: the manager sets it on the way in, and this worker alone is left unmarked and so
# may start workers. The lift is consumed rather than passed on — it is taken off the
# environment this worker inherits — so the workers it starts are marked like any other,
# and the recursion stops at the one level the manager asked for.
if [ -n "$HARING_ALLOW_NESTING" ]; then
  unset HARING_ALLOW_NESTING
else
  export HARING_NESTED="$run"
fi

schema="$HARING/kinds/$kind/schema.json"
# The worker's first message: the rules, the report it owes and the schema that report
# must match, then the task. OpenCode takes no system prompt from the command line, and
# an agent's own prompt would replace OpenCode's, so the rules travel in the message
# instead. A fresh run gets every rule; a continued one already holds kinds/rules.md from
# the run it continues and gets only its kind's rules, since the kind may differ. It is
# rebuilt for every run, not kept: regenerate any run's rules with `haring-prompt <kind>`.
{
  if [ -z "$resume_id" ]; then
    "$HARING/bin/haring-prompt" "$kind"
  else
    cat "$HARING/kinds/$kind/rules.md"
  fi
  printf '\n\n---\n\n## Your report\n\n'
  printf 'Your final message is your report, and a program reads it, not a person. It is\n'
  printf 'one JSON object and nothing else: no words before or after it, no markdown fence.\n'
  printf 'It matches this JSON schema exactly — every required field present, and no field\n'
  printf 'the schema does not list. A report that does not parse or does not match comes\n'
  printf 'back to you with what is wrong, to send again.\n\n'
  cat "$schema"
  printf '\n\n---\n\n'
  cat "$run/prompt.md"
} > "$run/message.tmp"

# The worker runs as its own session, not merely in the background. A background child
# stays in its launcher's process group, so anything that kills that group — a tool
# timeout, a cancelled command — kills the worker too, and it dies leaving an empty
# report. Detaching properly is the only way a long run survives the thing that started it.
#
# The three redirections on the python call below are load-bearing. A detached grandchild
# inherits whatever descriptors it is handed, and if it keeps the caller's stdout then
# `run=$(haring-worker ...)` never returns: command substitution waits for that pipe to
# close and the pipe stays open until the worker finishes.
#
# opencode reads a /dev/null of its own and nothing else. When its input is not a
# terminal it reads it to the end before it so much as reaches the server, and the stdin
# Claude Code hands its shells is one no JavaScript runtime ever sees the end of —
# measured, Bun and Node both hang on it where cat reads the end at once. It hangs with no
# event, no session and no error, and looks exactly like a provider outage. A freshly
# opened /dev/null ends at once. Steering does not need the pipe: haring-say posts into the live
# session through the OpenCode server.
#
# stdout is the event stream: --format json writes one event per finished part, and
# events.jsonl is the record haring owns. --thinking puts the worker's reasoning in it
# too, which is what haring-wait and haring-pulse show while a worker is quiet. report.json is rebuilt from it by
# lib/haring_report.py into the shape the readers already read. It is emptied first: an
# empty report.json is what haring-wait and haring-pulse treat as "not landed yet", and
# what a killed worker leaves behind.
#
# A final message that is not a report matching the schema is sent back to the same
# session with what is wrong, at most REPORT_RETRIES times, and the last answer is kept
# either way — written without structured_output, so the manager reads the raw text.
#
# The watchdog stops a run that has gone silent. The longest silence any run has
# recorded is 7.0 minutes and every run near it finished with a report, so fifteen
# minutes with no new event is a run that is not working. OpenCode writes a tool call
# only once it has finished, so a long command counts as silence until it returns.
# HARING_STALL_SECONDS overrides the fifteen minutes, so the stop can be tested in
# seconds rather than minutes. Killing the process group is
# not enough on its own: the session lives in the OpenCode server and goes on working
# with nobody reading it, so it is interrupted there first. The `stalled` file is
# written before the group is signalled, because the watchdog is in that group.
REPORT_RETRIES=2
stall_limit=${HARING_STALL_SECONDS:-900}
cat > "$run/run.sh" <<RUNNER
#!/bin/sh
echo "pid=\$\$" >> "$run/meta"
cd "$workdir" || exit 1
: > "$run/report.json"
live_session() {
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import haring_events
print(haring_events.live_session(sys.argv[2]))' "$HARING/lib" "$run" 2>/dev/null
}
(
  limit=$stall_limit
  while :; do
    sleep 15
    [ -f "$run/events.jsonl" ] || continue
    age=\$(( \$(date +%s) - \$(stat -f %m "$run/events.jsonl") ))
    [ "\$age" -ge "\$limit" ] || continue
    printf 'at=%s\nsilent=%s\n' "\$(date +%Y-%m-%dT%H:%M:%S)" "\$age" > "$run/stalled"
    sid=\$(live_session)
    [ -n "\$sid" ] || sid=$resume_id
    [ -z "\$sid" ] || "$HARING/workers/$worker/stop" "\$sid" </dev/null >/dev/null 2>&1
    kill -9 0
  done
) &
watchdog=\$!
if [ -n "$resume_id" ]; then
  "$HARING/workers/$worker/start" --kind "$kind" --model "$model" $effort_arg \
    --resume "$resume_id" $fork_arg "$run/message.tmp" \
    </dev/null >> "$run/events.jsonl" 2>> "$run/stderr.txt"
else
  "$HARING/workers/$worker/start" --kind "$kind" --model "$model" $effort_arg \
    --session-file "$run/session" "$run/message.tmp" \
    </dev/null >> "$run/events.jsonl" 2>> "$run/stderr.txt"
fi
tries=0
while :; do
  problem=\$(python3 "$HARING/lib/haring_report.py" "$run" "$schema")
  [ \$? -eq 1 ] || break
  tries=\$((tries + 1))
  if [ \$tries -gt $REPORT_RETRIES ]; then
    python3 "$HARING/lib/haring_report.py" "$run" "$schema" --final
    break
  fi
  sid=\$(live_session)
  printf 'Your final message was not the report. What is wrong with it:\n%s\n\nSend the report again: one JSON object matching the schema you were given, and nothing else.\n' \
    "\$problem" > "$run/retry.tmp"
  "$HARING/workers/$worker/start" --kind "$kind" --model "$model" $effort_arg \
    --resume "\$sid" "$run/retry.tmp" \
    </dev/null >> "$run/events.jsonl" 2>> "$run/stderr.txt"
  rm -f "$run/retry.tmp"
done
kill \$watchdog 2>/dev/null
[ -s "$run/stderr.txt" ] || rm -f "$run/stderr.txt"
"$HARING/bin/haring-stats" "$run" > "$run/stats.txt" 2>/dev/null || true
rm -f "$run/message.tmp" "$run/run.sh"
RUNNER
chmod +x "$run/run.sh"

python3 -c '
import os, sys, subprocess
if os.fork() > 0: os._exit(0)      # leave the caller
os.setsid()                        # become our own session, out of the group
if os.fork() > 0: os._exit(0)      # never reacquire a terminal
subprocess.run(["/bin/sh", sys.argv[1]],
               stdin=subprocess.DEVNULL,
               stdout=subprocess.DEVNULL,
               stderr=subprocess.DEVNULL)
' "$run/run.sh" </dev/null >/dev/null 2>&1

# The runner records its own pid, so give it a moment to appear.
i=0
while [ ! -s "$run/meta" ] || ! grep -q '^pid=' "$run/meta"; do
  i=$((i + 1)); [ "$i" -gt 50 ] && break
  sleep 0.1
done

# Nothing else names the pulse, and three runs in a row went unwatched for it. The
# moment a manager would start one is this one: it is reading this launch's output, and
# the pulse it starts here covers the run it is about to read.
echo "haring: watch it as it goes — haring-pulse $project" >&2
echo "$run"
