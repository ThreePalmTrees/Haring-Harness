#!/bin/sh
# haring-prompt — build a worker's system prompt.
#
#   haring-prompt <kind>
#
# The rules for every worker, then the rules for this kind of task.
set -e
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

usage() {
  echo "usage: haring-prompt <kind>" >&2
  exit 2
}

[ $# -eq 1 ] || usage
kind=$1
[ -n "$kind" ] || usage
[ -f "$HARING/kinds/$kind/rules.md" ] || { echo "unknown kind: $kind" >&2; usage; }

cat "$HARING/kinds/rules.md"
printf '\n\n---\n\n'
cat "$HARING/kinds/$kind/rules.md"
