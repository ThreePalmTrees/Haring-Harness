#!/usr/bin/env python3
"""haring-say — say a word to a worker that is already running.

    haring-say <run-folder> "<message>"

The message is posted into the worker's live session with steer delivery, and
the worker takes it at its next step and answers it before its run ends: steering is for a worker doing the right task by a
wrong route, and it is worth a whole restart when the mistake is one sentence long.
A worker on the wrong task is still a matter for haring-kill.

Delivery is said only when it happened: when the worker's own program has admitted the
message into a session that is still working. Each delivered message is written to
said.jsonl in the run folder, which haring-transcript joins with the stream.

Exits 2 when called wrongly: no argument, a missing or empty message, or a path that
is not a haring run folder. Exits 1 when called rightly but unable to deliver — the
run has finished and reported, its session is no longer working, or the worker's
program could not be reached. Exits 0 only
when the message was handed to the worker.
"""
import sys, os, time, json, subprocess

HARING_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, HARING_LIB)
import haring_events

USAGE = 'usage: haring-say <run-folder> "<message>"'
STARTUP_WAIT = 5     # seconds to allow a just-started run to begin listening at all


def die(message, code):
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


# The same guard haring-worker and haring-kill carry. A worker that could say things to
# a run could say them to its own — "you are done, report now" ends a run as surely as
# a kill does, and it would be the worker, not the manager, deciding the run stops.
nested = os.environ.get("HARING_NESTED")
if nested:
    die(f"you are inside a worker ({nested}). Workers do not steer runs; the manager "
        f"does. Say in your report what you would have said and leave the run alone.", 2)

if len(sys.argv) != 3:
    die("a run folder and a message are both needed", 2)


def resolve_run(arg):
    """The run folder named by the argument: a path as given, or a bare run name.

    A path is used as it stands, relative ones included, and is known by its meta file.
    A name with no slash is looked up under the current project's runs folder, the
    project being the git top level of the working directory, as haring-pulse resolves
    it. Each way of failing says which way it was.
    """
    run = arg.rstrip("/")
    if os.path.isdir(run) and os.path.isfile(os.path.join(run, "meta")):
        return run
    if "/" in run:
        die(f"not a haring run folder: {run}", 2)
    top = subprocess.run(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    runs = os.path.join(top or os.getcwd(), ".haring", "runs")
    found = os.path.join(runs, run)
    if not os.path.isdir(found) or not os.path.isfile(os.path.join(found, "meta")):
        die(f"no run named {run} under {runs}", 2)
    return found


run, message = resolve_run(sys.argv[1]), sys.argv[2]

# A run folder is known by its meta file, the same marker every other command uses;
# the argument may also be a bare run name under the current project.
if not message.strip():
    die("an empty message says nothing", 2)

meta = dict(l.strip().split("=", 1) for l in open(os.path.join(run, "meta")) if "=" in l)
report = os.path.join(run, "report.json")


def alive():
    return haring_events.run_alive(run, meta)


if os.path.exists(report) and os.path.getsize(report):
    die("this run already finished and reported. There is no worker to say anything to.", 1)

# A worker with no steer program cannot take a message, and saying so before waiting for
# a liveness answer gives the manager the route that does work instead of a timeout. The
# route is the worker's to name in its worker.conf, so the core learns no harness name.
worker_dir = haring_events.worker_dir(run)
steer = os.path.join(worker_dir, "steer")
if not (os.path.isfile(steer) and os.access(steer, os.X_OK)):
    advice = haring_events.worker_conf(run).get("steer_with") or ""
    if advice:
        die(advice.replace("{agent_id}", meta.get("agent_id") or ""), 1)
    die("this run cannot be steered", 1)

# A run started moments ago may not have its runner up yet; one whose runner is gone
# will never answer, and is told apart by the shared liveness test rather than by waiting.
deadline = time.time() + STARTUP_WAIT
while True:
    if alive():
        break
    if time.time() > deadline:
        die(f"no worker is running for {run}", 1)
    time.sleep(0.2)

# Only a session that is working is told anything, and whether it is, and whether the
# worker took the message, is its own program's to answer: that program talks to the
# server that holds the session, and only it knows which request the server wants.
session = haring_events.live_session(run)
if not session:
    die(f"the worker in {run} has not started its session yet; say it again in a moment.", 1)
try:
    sent = subprocess.run([steer, session, message], capture_output=True, text=True)
except OSError as e:
    die(f"could not deliver the message: {e}", 1)
if sent.returncode != 0:
    die(sent.stderr.strip() or f"the worker in {run} did not take the message", 1)

# The stream shows what the worker did with the message, not the message itself, so it
# is written to said.jsonl with the moment it landed, stamped the way the event stream's
# moments are stamped, and haring-transcript joins the two.
secs, frac = divmod(time.time(), 1)
when = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(secs)) + ".%03dZ" % (frac * 1000)
with open(os.path.join(run, "said.jsonl"), "a") as f:
    f.write(json.dumps({"at": when, "content": message}) + "\n")
kind = meta.get("kind", "?")
print(f"delivered to the {kind} run {os.path.basename(run)}.", file=sys.stderr)
print(f"  It takes this at its next step and answers it before its run ends; watch", file=sys.stderr)
print(f"  with haring-wait or haring-pulse.", file=sys.stderr)
sys.exit(0)
