<script id="run-data" type="application/json">__DATA__</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("run-data").textContent);
  var RUNS = DATA.runs || [];
  var ORDER = ["ok", "error", "stopped", "stalled", "running", "no report"];
  var NUMERIC = {"started": true, "durationSecs": true, "turns": true,
                 "tokensIn": true, "tokensOut": true, "cacheRead": true};
  var sortKey = "started";
  var sortDir = -1;

  function esc(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
      return {"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"}[c];
    });
  }
  function num(value) {
    return value == null ? "—" : Number(value).toLocaleString("en-US");
  }
  function duration(seconds) {
    if (seconds == null) return "—";
    var s = Math.max(0, Math.round(seconds));
    if (s < 60) return s + "s";
    var m = Math.floor(s / 60); s = s % 60;
    if (m < 60) return m + "m " + s + "s";
    var h = Math.floor(m / 60); m = m % 60;
    if (h < 24) return h + "h " + m + "m";
    return Math.floor(h / 24) + "d " + (h % 24) + "h";
  }
  function outcomeClass(value) {
    return String(value).toLowerCase().replace(/[^a-z0-9]+/g, "-");
  }
  function total(key) {
    var t = 0;
    RUNS.forEach(function (r) { if (r[key] != null) t += r[key]; });
    return t;
  }
  function grouped(key) {
    var map = new Map();
    RUNS.forEach(function (r) {
      var name = r[key] || "unknown";
      var g = map.get(name);
      if (!g) {
        g = {"name": name, "runs": 0, "durationSecs": 0, "tokensIn": 0,
             "tokensOut": 0, "cacheRead": 0};
        map.set(name, g);
      }
      g.runs += 1;
      ["durationSecs", "tokensIn", "tokensOut", "cacheRead"].forEach(function (f) {
        if (r[f] != null) g[f] += r[f];
      });
    });
    return Array.from(map.values()).sort(function (a, b) {
      return b.runs - a.runs || a.name.localeCompare(b.name);
    });
  }
  function renderTotals() {
    var cards = [
      ["Runs", num(RUNS.length)],
      ["Time", duration(total("durationSecs"))],
      ["Input tokens", num(total("tokensIn"))],
      ["Output tokens", num(total("tokensOut"))],
      ["Cache reads", num(total("cacheRead"))]
    ];
    document.getElementById("totals").innerHTML = cards.map(function (c) {
      return '<div class="card"><div class="label">' + esc(c[0]) +
             '</div><div class="value">' + esc(c[1]) + "</div></div>";
    }).join("");
  }
  function renderOutcomes() {
    var count = {};
    RUNS.forEach(function (r) { count[r.outcome] = (count[r.outcome] || 0) + 1; });
    var seen = ORDER.filter(function (o) { return count[o]; });
    Object.keys(count).forEach(function (o) {
      if (ORDER.indexOf(o) < 0) seen.push(o);
    });
    document.getElementById("outcomes").innerHTML = seen.map(function (o) {
      return '<span class="chip outcome outcome-' + esc(outcomeClass(o)) + '">' +
             esc(o) + " " + num(count[o]) + "</span>";
    }).join("");
  }
  function renderGroupTable(target, rows, label) {
    var host = document.getElementById(target);
    if (!rows.length) {
      host.innerHTML = '<p class="empty">No runs.</p>';
      return;
    }
    var max = Math.max.apply(null, rows.map(function (r) { return r.runs; }).concat([1]));
    host.innerHTML = "<table><thead><tr><th>" + esc(label) +
      '</th><th class="num">Runs</th><th class="num">Time</th>' +
      '<th class="num">Input tokens</th><th class="num">Output tokens</th>' +
      '<th class="num">Cache reads</th></tr></thead><tbody>' +
      rows.map(function (r) {
        var width = Math.max(1, Math.round(r.runs / max * 100));
        return '<tr><td class="name">' + esc(r.name) +
          '<div class="bar" aria-hidden="true"><span style="width:' + width + '%"></span></div></td>' +
          '<td class="num">' + num(r.runs) + '</td>' +
          '<td class="num">' + duration(r.durationSecs) + '</td>' +
          '<td class="num">' + num(r.tokensIn) + '</td>' +
          '<td class="num">' + num(r.tokensOut) + '</td>' +
          '<td class="num">' + num(r.cacheRead) + '</td></tr>';
      }).join("") + "</tbody></table>";
  }
  function byDay() {
    var rows = grouped("day");
    return rows.sort(function (a, b) { return b.name.localeCompare(a.name); });
  }
  function compare(a, b) {
    if (NUMERIC[sortKey]) {
      var av = a[sortKey], bv = b[sortKey];
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return (av - bv) * sortDir;
    }
    return String(a[sortKey] == null ? "" : a[sortKey])
      .localeCompare(String(b[sortKey] == null ? "" : b[sortKey])) * sortDir;
  }
  function renderRuns() {
    var rows = RUNS.slice().sort(compare);
    var body = document.getElementById("run-rows");
    body.innerHTML = rows.length ? rows.map(function (r) {
      return '<tr><td class="mono" title="' + esc(r.run) + '">' + esc(r.start) + "</td>" +
        "<td>" + esc(r.kind) + "</td>" +
        "<td>" + esc(r.worker) + "</td>" +
        '<td class="mono">' + esc(r.model) + "</td>" +
        '<td class="num">' + duration(r.durationSecs) + "</td>" +
        '<td class="num">' + num(r.turns) + "</td>" +
        '<td class="num">' + num(r.tokensIn) + "</td>" +
        '<td class="num">' + num(r.tokensOut) + "</td>" +
        '<td class="num">' + num(r.cacheRead) + "</td>" +
        '<td class="outcome outcome-' + esc(outcomeClass(r.outcome)) + '">' +
        esc(r.outcome) + "</td></tr>";
    }).join("") : '<tr><td colspan="10" class="empty">No runs yet.</td></tr>';
    document.querySelectorAll("#runs-table th").forEach(function (th) {
      var active = th.getAttribute("data-key") === sortKey;
      th.setAttribute("aria-sort", active ? (sortDir === 1 ? "ascending" : "descending") : "none");
      var mark = th.querySelector(".mark");
      if (mark) mark.textContent = active ? (sortDir === 1 ? "▲" : "▼") : "";
    });
  }

  document.querySelectorAll("#runs-table th button").forEach(function (button) {
    button.addEventListener("click", function () {
      var key = button.parentElement.getAttribute("data-key");
      if (sortKey === key) {
        sortDir = -sortDir;
      } else {
        sortKey = key;
        sortDir = key === "started" ? -1 : 1;
      }
      renderRuns();
    });
  });

  document.getElementById("generated").textContent =
    "Built " + DATA.generated + " from " + RUNS.length + " run folder" +
    (RUNS.length === 1 ? "" : "s") + ".";
  renderTotals();
  renderOutcomes();
  renderGroupTable("by-worker", grouped("worker"), "Worker");
  renderGroupTable("by-model", grouped("model"), "Model");
  renderGroupTable("by-kind", grouped("kind"), "Kind");
  renderGroupTable("by-day", byDay(), "Day");
  renderRuns();
})();
</script>
</body>
</html>
"""


def build_page(project, rows):
    data = {
        "project": project,
        "generated": time.strftime("%Y-%m-%d %H:%M:%S"),
        "runs": rows,
    }
    # `</script>` inside a string would end the block that holds the data. A unicode
    # escape is still JSON and cannot close it.
    data_json = json.dumps(data, ensure_ascii=True, separators=(",", ":")).replace("<", "\\u003c")
    return (PAGE.replace("__PROJECT__", html.escape(project))
                .replace("__DATA__", data_json))


def main():
    project, out = parse_args(sys.argv[1:])
    rows = collect(project)
    page = build_page(project, rows)
    parent = os.path.dirname(out)
    try:
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(out, "w", encoding="utf-8") as f:
            f.write(page)
    except OSError as e:
        die(f"cannot write {out}: {e}", 1)
    print(f"wrote {out} ({len(rows)} runs)")


if __name__ == "__main__":
    main()
