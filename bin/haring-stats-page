            <th class="num" data-key="turns"><button class="sort" type="button">Turns <span class="mark"></span></button></th>
            <th class="num" data-key="tokensIn"><button class="sort" type="button">Input tokens <span class="mark"></span></button></th>
            <th class="num" data-key="tokensOut"><button class="sort" type="button">Output tokens <span class="mark"></span></button></th>
            <th class="num" data-key="cacheRead"><button class="sort" type="button">Cache reads <span class="mark"></span></button></th>
            <th data-key="outcome"><button class="sort" type="button">Outcome <span class="mark"></span></button></th>
          </tr>
        </thead>
        <tbody id="run-rows"></tbody>
      </table>
