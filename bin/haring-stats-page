  <section>
    <h2>Every run</h2>
    <p class="sub">Click a column name to sort. Duration and tokens are what the run's report recorded.</p>
    <div class="runs-wrap">
      <table id="runs-table">
        <thead>
          <tr>
            <th data-key="started"><button class="sort" type="button">Started <span class="mark"></span></button></th>
            <th data-key="kind"><button class="sort" type="button">Kind <span class="mark"></span></button></th>
            <th data-key="worker"><button class="sort" type="button">Worker <span class="mark"></span></button></th>
            <th data-key="model"><button class="sort" type="button">Model <span class="mark"></span></button></th>
