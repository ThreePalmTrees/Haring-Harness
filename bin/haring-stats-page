#!/usr/bin/env python3
"""haring-stats-page — one self-contained page of every run in a project.

    haring-stats-page [project] [--out file]

Writes an HTML file that opens from disk with no server and no network: the runs are
embedded as JSON, the charts are CSS, and the little JavaScript sorts the table. The
default output is <project>/.haring/stats.html. A run's numbers come from
lib/haring_run.run_numbers, the same function haring-stats prints from, so the page and
the terminal line cannot disagree.

Never prints or stores money: the report's cost fields are not read. A run with a
missing, empty or odd report still appears, with whatever its meta and folder say, and
never stops the page from being built.
"""
import html, json, math, os, subprocess, sys, time

HARING_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, HARING_LIB)
import haring_events, haring_run

USAGE = "usage: haring-stats-page [project] [--out file]"


def die(message, code):
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


def parse_args(argv):
    project, out = None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--out":
            i += 1
            if i >= len(argv):
                die("--out needs a file", 2)
            out = argv[i]
        elif a.startswith("--out="):
            out = a.split("=", 1)[1]
            if not out:
                die("--out needs a file", 2)
        elif a in ("-h", "--help"):
            print(USAGE)
            print("Write a self-contained HTML page of every run under <project>/.haring/runs.")
            sys.exit(0)
        elif a.startswith("-") and a != "-":
            die(f"unknown option: {a}", 2)
        elif project is None:
            project = a
        else:
            die("haring-stats-page takes at most one project directory", 2)
        i += 1
    if project is None:
        top = subprocess.run(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True).stdout.strip()
        project = top or os.getcwd()
    project = os.path.abspath(os.path.expanduser(project))
    if not os.path.isdir(project):
        die(f"not a directory: {project}", 2)
    if out is None:
        out = os.path.join(project, ".haring", "stats.html")
    else:
        out = os.path.abspath(os.path.expanduser(out))
    return project, out


def stamp_from_name(run, name):
    """The start a run folder's name records, as epoch seconds, or its file time.

    A folder made by haring-worker begins YYYY-MM-DD-HHMMSS-kind-... . A run whose meta
    is gone still has that name, so its start is known without guessing from a modified
    file time.
    """
    parts = name.split("-")
    if len(parts) >= 4 and all(p.isdigit() for p in parts[:3]) and len(parts[3]) == 6:
        try:
            return time.mktime(time.strptime("-".join(parts[:3]) + " " + parts[3],
                                               "%Y-%m-%d %H%M%S"))
        except ValueError:
            pass
    try:
        return os.path.getmtime(run)
    except OSError:
        return 0.0


def kind_from_name(name):
    """The kind a run folder's name records, for a run whose meta is gone."""
    parts = name.split("-")
    return parts[4] if len(parts) >= 5 and parts[4] else "unknown"


def start_of(run, name, meta):
    """A run's start as epoch seconds, from meta when that number is readable and from
    the folder name otherwise. A number the clock cannot represent is not a start."""
    try:
        started = float(haring_events.run_started(run, meta))
        if math.isfinite(started):
            time.localtime(started)
            return started
    except (OSError, OverflowError, TypeError, ValueError):
        pass
    return stamp_from_name(run, name)


NUMERIC_FIELDS = ("secs", "turns", "in", "out", "cache_read")


def usable_numbers(nums):
    """The numbers a report gave, or None when a field is the wrong kind.

    A report whose fields are not finite numbers and a boolean error is one the page
    treats as no report: it still has the run's meta and folder to show, and a string
    where a count belongs would make the totals meaningless rather than informative.
    """
    if nums is None:
        return None
    for key in NUMERIC_FIELDS:
        value = nums.get(key)
        if (not isinstance(value, (int, float)) or isinstance(value, bool)
                or not math.isfinite(value)):
            return None
    if not isinstance(nums.get("error"), bool):
        return None
    return nums


def outcome_of(run, nums, meta):
    """What became of a run: an explicit marker, its report, its live worker, or nothing.

    A stopped or stalled run carries the marker the command that acted on it wrote. A
    readable report is the run's own answer, an error when it says so. A run with no
    readable report but a live worker is still going; one with neither is a run that
    ended without a report.
    """
    if os.path.exists(os.path.join(run, "stopped")):
        return "stopped"
    if os.path.exists(os.path.join(run, "stalled")):
        return "stalled"
    if nums is not None:
        return "error" if nums["error"] else "ok"
    try:
        alive = haring_events.run_alive(run, meta)
    except (Exception, SystemExit):
        alive = False
    return "running" if alive else "no report"


def row_for(run, name):
    """One run as the page's data holds it: what is known, blank where nothing is."""
    meta = haring_run.read_meta(run)
    started = start_of(run, name, meta)
    nums = None
    try:
        nums = usable_numbers(haring_run.run_numbers(run, meta=meta))
    except (Exception, SystemExit):
        pass
    model = nums["model"] if nums is not None else (meta.get("model") or "unknown")
    return {
        "run": name,
        "started": round(started, 3),
        "start": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(started)),
        "day": time.strftime("%Y-%m-%d", time.localtime(started)),
        "kind": meta.get("kind") or kind_from_name(name),
        "worker": meta.get("worker") or "opencode",
        "model": model,
        "durationSecs": nums["secs"] if nums is not None else None,
        "turns": nums["turns"] if nums is not None else None,
        "tokensIn": nums["in"] if nums is not None else None,
        "tokensOut": nums["out"] if nums is not None else None,
        "cacheRead": nums["cache_read"] if nums is not None else None,
        "outcome": outcome_of(run, nums, meta),
    }


def collect(project):
    runs_dir = os.path.join(project, ".haring", "runs")
    try:
        names = sorted(os.listdir(runs_dir))
    except OSError:
        return []
    rows = []
    for name in names:
        run = os.path.join(runs_dir, name)
        if not os.path.isdir(run):
            continue
        try:
            rows.append(row_for(run, name))
        except (Exception, SystemExit):
            # The page is a reading of the record, not a gate on it: a folder that
            # cannot be read still leaves its name and file time on the page.
            started = stamp_from_name(run, name)
            rows.append({
                "run": name,
                "started": round(started, 3),
                "start": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(started)),
                "day": time.strftime("%Y-%m-%d", time.localtime(started)),
                "kind": kind_from_name(name),
                "worker": "unknown",
                "model": "unknown",
                "durationSecs": None,
                "turns": None,
                "tokensIn": None,
                "tokensOut": None,
                "cacheRead": None,
                "outcome": "no report",
            })
    return rows


