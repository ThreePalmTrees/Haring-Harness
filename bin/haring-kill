#!/usr/bin/env python3
"""haring-kill — stop a running worker on purpose.

    haring-kill <run-folder>

Signals the worker's whole process group: the runner python, the shell running the
run's run.sh, and the harness client inside it — then asks the worker's own stop program
to interrupt the session, because the session lives in a server and goes on working
after its client dies. The chip's "x" on a background task does
none of this — it kills the haring-wait watching the run, and the worker survives it,
because haring-worker deliberately detached the worker into its own session so that it
outlives whatever started it. That same detachment is why an ordinary kill cannot reach
the worker, and why this command signals the group rather than a single pid.

It writes a `stopped` file into the run folder, so a deliberate stop reads as one:
haring-wait sees it and reports a stop on purpose instead of a worker that vanished,
which is otherwise indistinguishable from a crash.

What it stopped is said on standard error. Standard output carries nothing, like every
other haring command.

Exits 2 when called wrongly: no argument, a path that is not a haring run folder, or a
call from inside a worker, which may not stop a run.
Exits 1 when called rightly but unable to finish — no worker is running for that run,
the run has already finished and reported, or the worker would not die. Exits 0 when the
worker is dead, including when a previous haring-kill had already stopped it.
"""
import sys, os, time, signal, subprocess

HARING_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, HARING_LIB)
import haring_events

USAGE = "usage: haring-kill <run-folder>"
GRACE = 5   # seconds a group is given to die of SIGTERM before it is SIGKILLed


def die(message, code):
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


# The same guard haring-worker puts on starting a run is on stopping one. The marker came
# from the haring-worker that started this worker and it is in the environment of every
# shell command that worker runs, so there is no route to this code that does not carry
# it. Only the manager decides a run stops: the work is on disk and the account of it is
# not, and that trade is not a worker's to make.
nested = os.environ.get("HARING_NESTED")
if nested:
    die(f"you are inside a worker ({nested}). Workers do not stop runs; the manager does. "
        f"Say in your report that the run needs stopping, and leave it running.", 2)


if len(sys.argv) != 2:
    print(USAGE, file=sys.stderr)
    sys.exit(2)

def resolve_run(arg):
    """The run folder named by the argument: a path as given, or a bare run name.

    A path is used as it stands, relative ones included, and is known by its meta file.
    A name with no slash is looked up under the current project's runs folder, the
    project being the git top level of the working directory, as haring-pulse resolves
    it. Each way of failing says which way it was.
    """
    run = arg.rstrip("/")
    if os.path.isdir(run) and os.path.isfile(os.path.join(run, "meta")):
        return run
    if "/" in run:
        die(f"not a haring run folder: {run}", 2)
    top = subprocess.run(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    runs = os.path.join(top or os.getcwd(), ".haring", "runs")
    found = os.path.join(runs, run)
    if not os.path.isdir(found) or not os.path.isfile(os.path.join(found, "meta")):
        die(f"no run named {run} under {runs}", 2)
    return found


# A run folder is known by its meta file, the same marker `haring-worker continue` uses;
# the argument may also be a bare run name under the current project.
run = resolve_run(sys.argv[1])
meta = dict(l.strip().split("=", 1) for l in open(os.path.join(run, "meta")) if "=" in l)
marker = os.path.join(run, "stopped")

if os.path.exists(marker):
    rec = dict(l.strip().split("=", 1) for l in open(marker) if "=" in l)
    print(f"already stopped on purpose at {rec.get('at', '?')} by {rec.get('user', '?')}.",
          file=sys.stderr)
    sys.exit(0)

# The pid in meta belongs to the shell, and is not trusted on its own: pids are reused,
# and a stale one can name a process with nothing to do with this run, whose process
# group is not ours to signal. Both spellings of the folder are matched, because a
# process carries the path the worker was handed and realpath resolves symlinks — on
# macOS /tmp is a link to /private/tmp, so the realpath of a run started under /tmp
# matches nothing on any command line.
here = os.path.realpath(run)
named = os.path.abspath(run)
tail = os.path.basename(run)
session = haring_events.live_session(run)


def names_run(command):
    return here in command or named in command or tail in command or (
        bool(session) and session in command)


def is_worker(command):
    return bool(command.split()) and os.path.basename(command.split()[0]) == "opencode"


def rows():
    """Every live process as (pid, pgid, command).

    Zombies are left out: a dead process still answers a signal for as long as it is
    unreaped, and counting one would make a finished stop look unfinished.
    """
    out = subprocess.run(["ps", "-axo", "pid=,pgid=,stat=,command="],
                         capture_output=True, text=True).stdout
    found = []
    for line in out.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) < 4 or "Z" in parts[2]:
            continue
        found.append((int(parts[0]), int(parts[1]), parts[3]))
    return found


def worker_group():
    """The process group the worker itself runs in, or None when it is not running.

    The anchor is the shell meta names, then the opencode client. A haring-wait watching
    this run names the run folder on its own command line, and so does any command the
    manager runs that mentions the folder; taking one of those for the worker would
    signal its group instead and leave the worker alive.
    """
    live = rows()
    by_pid = {p: (p, g, c) for p, g, c in live}
    pid = meta.get("pid", "")
    if pid.isdigit() and int(pid) in by_pid:
        _, pgid, command = by_pid[int(pid)]
        if names_run(command):
            return pgid
    for _, pgid, command in live:
        if is_worker(command) and session and session in command:
            return pgid
    return None


# One group holds the whole run: haring-worker's setsid made it, and nothing the run
# starts afterwards leaves it. Signalling the group is what reaches the opencode client —
# the pid in meta is its shell, and killing that alone would orphan the client mid-run.
group = worker_group()
if group is None:
    report = os.path.join(run, "report.json")
    if os.path.exists(report) and os.path.getsize(report):
        die("this run already finished and reported. There is no worker to stop.", 1)
    die(f"no worker is running for {run}", 1)


def still_there():
    return sorted(pid for pid, pgid, _ in rows() if pgid == group)


live = rows()
members = sorted(p for p, g, _ in live if g == group)
client = sorted(p for p, g, c in live if g == group and is_worker(c))

for sig in (signal.SIGTERM, signal.SIGKILL):
    try:
        os.killpg(group, sig)
    except ProcessLookupError:
        break
    end = time.time() + GRACE
    while time.time() < end and still_there():
        time.sleep(0.2)
    if not still_there():
        break

left = still_there()
if left:
    die(f"the worker in process group {group} is still alive after SIGKILL: {left}", 1)

# The client is gone and the session is not: measured, a session whose client was killed
# is still running in the server three seconds later, and only an interrupt stops it.
stop = os.path.join(haring_events.worker_dir(run), "stop")
if session:
    stopped = subprocess.run([stop, session], capture_output=True, text=True)
    interrupted, answer = stopped.returncode == 0, stopped.stderr.strip()
else:
    interrupted, answer = False, "no session id in the stream, the session file or meta"

now = time.strftime("%Y-%m-%dT%H:%M:%S")
with open(marker, "w") as f:
    f.write(f"at={now}\n")
    f.write(f"user={os.environ.get('USER') or '?'}\n")
    f.write(f"pgid={group}\n")
    f.write(f"pids={' '.join(str(p) for p in members)}\n")
    f.write(f"session={session}\n")

kind = meta.get("kind", "?")
inside = f", opencode was pid {', '.join(str(p) for p in client)}" if client else ""
print(f"stopped {kind} run {os.path.basename(run)}", file=sys.stderr)
print(f"  process group {group}: pids {' '.join(str(p) for p in members)}{inside}",
      file=sys.stderr)
print(f"  recorded in {marker}", file=sys.stderr)
if interrupted:
    print(f"  the session {session} was interrupted", file=sys.stderr)
else:
    print(f"  !! the session {session or '?'} was not interrupted, and may still be "
          f"working: {answer[:300]}", file=sys.stderr)
    print(f"     stop it with: {stop} {session}", file=sys.stderr)
