#!/usr/bin/env python3
"""haring-stats — one line of numbers from a worker's result JSON.

    haring-stats <run-folder>

Never prints money. The figure the tool reports is computed with the wrong price
table for these models and is wrong.

Exits 2 when called wrongly — no argument, a path that is not a run folder. Exits 1 when
it was called rightly and there is no report and no live worker — a report that is missing
or empty with the worker gone. Exits 3 while the worker is still alive and has not reported,
which is an answer rather than a failure, and says so on standard error: a busy run must not
read as a dead one, and must not read as numbers either.
"""
import sys, json, os, time

USAGE = "usage: haring-stats <run-folder>"


def die(message, code):
    # A wrongly-called command gets the reason and the usage line; a run that
    # could not be read gets the reason alone.
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


if len(sys.argv) != 2:
    print(USAGE, file=sys.stderr)
    sys.exit(2)

# Every haring command that acts on a run takes the run folder, and only the run
# folder. A run folder is known by its meta file, the same marker `haring-worker
# continue` uses.
run = sys.argv[1].rstrip("/")
if not os.path.isdir(run) or not os.path.isfile(os.path.join(run, "meta")):
    die(f"not a haring run folder: {run}", 2)
# The same liveness test haring-wait uses: a pid that answers signal 0 is a worker still
# going. The report file alone cannot tell a run in flight from a dead one — a run that
# was killed leaves the same empty file a running one has not filled yet.
def live_pid(run):
    try:
        meta = dict(l.strip().split("=", 1) for l in open(os.path.join(run, "meta")) if "=" in l)
    except OSError:
        return None
    pid = meta.get("pid", "")
    if not pid.isdigit():
        return None
    try:
        os.kill(int(pid), 0)
    except OSError:
        return None
    return pid


path = os.path.join(run, "report.json")
landed = os.path.exists(path) and os.path.getsize(path) > 0
if not landed:
    pid = live_pid(run)
    if pid:
        # Elapsed is measured from the meta file, as haring-wait measures it: the worker
        # records its pid there when it starts, so its mtime is the moment the run began.
        secs = max(0, int(time.time() - os.path.getmtime(os.path.join(run, "meta"))))
        # Standard output carries the numbers and nothing else, so this goes to standard
        # error and gets an exit of its own. A caller that captured this on stdout with a
        # success code would read a sentence where it expected `model=... in=...`, and a
        # run still working would be indistinguishable from one that had reported.
        print(f"still running: pid {pid} alive, {secs // 60}m{secs % 60:02d}s in, "
              f"no report yet at {path}", file=sys.stderr)
        sys.exit(3)
    if not os.path.exists(path):
        die(f"no report yet at {path}", 1)
    die(f"the report at {path} is empty: the worker returned nothing", 1)
try:
    d = json.load(open(path))
except Exception as e:
    die(f"unreadable report: {e}", 1)

# report.json is the last result event alone, and every message said to a running worker
# produces a result event of its own — so on a steered run these fields describe only that
# last turn, in the direction that flatters. The stream holds all of them, so turns,
# seconds and the token counts are summed over every result event. What the run ended with
# still comes from report.json, which is the event that says how it ended. A stream with no
# readable result event falls back to report.json's own numbers, which is what an unsteered
# run sums to anyway.
totals, ms, turns, found = {}, 0, 0, 0
try:
    for line in open(os.path.join(run, "events.jsonl")):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") != "result":
            continue
        found += 1
        ms += e.get("duration_ms") or 0
        turns += e.get("num_turns") or 0
        for name, u in (e.get("modelUsage") or {}).items():
            t = totals.setdefault(name, {})
            for k in ("inputTokens", "outputTokens", "cacheReadInputTokens"):
                t[k] = t.get(k, 0) + (u.get(k) or 0)
except OSError:
    pass

mu = d.get("modelUsage") or {}
model = next(iter(mu), "?")
m = totals[model] if model in totals else mu.get(model, {})
if not found:
    ms = d.get("duration_ms", 0)
    turns = d.get("num_turns", 0)
secs = round(ms / 1000)
print(
    f"model={model} "
    f"in={m.get('inputTokens', 0)} "
    f"out={m.get('outputTokens', 0)} "
    f"cache_read={m.get('cacheReadInputTokens', 0)} "
    f"turns={turns} "
    f"secs={secs} "
    f"error={d.get('is_error')} "
    f"ended={d.get('terminal_reason') or d.get('stop_reason')}"
)
den = d.get("permission_denials") or []
if den:
    print(f"denials={len(den)}")
