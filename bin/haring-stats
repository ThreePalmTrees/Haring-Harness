#!/usr/bin/env python3
"""haring-stats — one line of numbers from a worker's result JSON.

    haring-stats <run-folder>

Never prints money. The figure the tool reports is computed with the wrong price
table for these models and is wrong.

Exits 2 when called wrongly — no argument, a path that is not a run folder. Exits 1 when
it was called rightly and there is no report and no live worker — a report that is missing
or empty with the worker gone. Exits 3 while the worker is still alive and has not reported,
which is an answer rather than a failure, and says so on standard error: a busy run must not
read as a dead one, and must not read as numbers either.
"""
import sys, json, os, time, subprocess

HARING_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, HARING_LIB)
import haring_events

USAGE = "usage: haring-stats <run-folder>"


def die(message, code):
    # A wrongly-called command gets the reason and the usage line; a run that
    # could not be read gets the reason alone.
    print(message, file=sys.stderr)
    if code == 2:
        print(USAGE, file=sys.stderr)
    sys.exit(code)


if len(sys.argv) != 2:
    print(USAGE, file=sys.stderr)
    sys.exit(2)


def resolve_run(arg):
    """The run folder named by the argument: a path as given, or a bare run name.

    A path is used as it stands, relative ones included, and is known by its meta file.
    A name with no slash is looked up under the current project's runs folder, the
    project being the git top level of the working directory, as haring-pulse resolves
    it. Each way of failing says which way it was.
    """
    run = arg.rstrip("/")
    if os.path.isdir(run) and os.path.isfile(os.path.join(run, "meta")):
        return run
    if "/" in run:
        die(f"not a haring run folder: {run}", 2)
    top = subprocess.run(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    runs = os.path.join(top or os.getcwd(), ".haring", "runs")
    found = os.path.join(runs, run)
    if not os.path.isdir(found) or not os.path.isfile(os.path.join(found, "meta")):
        die(f"no run named {run} under {runs}", 2)
    return found


# Every haring command that acts on a run takes the run folder, and only the run
# folder. A run folder is known by its meta file, the same marker `haring-worker
# continue` uses; the argument may also be a bare run name under the current project.
run = resolve_run(sys.argv[1])
# The same liveness test haring-wait uses: the pid answers signal 0 and its command
# names this run's folder, because a pid handed to an unrelated process is not a worker
# still going. The report file alone cannot tell a run in flight from a dead one — a run
# that was killed leaves the same empty file a running one has not filled yet.
def live_pid(run):
    try:
        meta = dict(l.strip().split("=", 1) for l in open(os.path.join(run, "meta")) if "=" in l)
    except OSError:
        return None
    pid = meta.get("pid", "")
    return pid if haring_events.run_pid_alive(run, pid) else None


# The pulse is the one watcher a still-running answer can name without guessing: it
# leaves its pid in <project>/.haring/pulse, and .haring sits two levels above the run
# folder, so the same call resolves the same project from any working directory. Every
# clause is checked — the file read, the pid alive, the command a haring-pulse — and
# anything that cannot be checked is omitted rather than said.
def watching_pulse(run):
    pulse_file = os.path.join(os.path.dirname(os.path.dirname(run)), "pulse")
    try:
        text = open(pulse_file).read().strip()
    except OSError:
        return None
    if not text.isdigit():
        return None
    try:
        os.kill(int(text), 0)
    except OSError:
        return None
    try:
        out = subprocess.run(["ps", "-p", text, "-o", "command="],
                             capture_output=True, text=True)
    except OSError:
        return None
    if out.returncode != 0 or "haring-pulse" not in out.stdout:
        return None
    return text


path = os.path.join(run, "report.json")
landed = os.path.exists(path) and os.path.getsize(path) > 0
if not landed:
    pid = live_pid(run)
    if pid:
        # Elapsed is measured from the meta file, as haring-wait measures it: the worker
        # records its pid there when it starts, so its mtime is the moment the run began.
        secs = max(0, int(time.time() - os.path.getmtime(os.path.join(run, "meta"))))
        # Standard output carries the numbers and nothing else, so this goes to standard
        # error and gets an exit of its own. A caller that captured this on stdout with a
        # success code would read a sentence where it expected `model=... in=...`, and a
        # run still working would be indistinguishable from one that had reported.
        print(f"still running: pid {pid} alive, {secs // 60}m{secs % 60:02d}s in, "
              f"no report yet at {path}", file=sys.stderr)
        print("Asking again can show you nothing but this line and the minutes going by; "
              "the news, when it comes, is the report replacing this line or word that the "
              "worker is gone without one. This command answers once and waits for nothing "
              "— the waiting belongs to whatever you armed to wait.", file=sys.stderr)
        watcher = watching_pulse(run)
        if watcher:
            print(f"haring-pulse pid {watcher} is watching this project's runs, "
                  f"this one included from its next pass; what the pulse prints, "
                  f"re-asking this command will not add.", file=sys.stderr)
        sys.exit(3)
    if not os.path.exists(path):
        die(f"no report yet at {path}", 1)
    die(f"the report at {path} is empty: the worker returned nothing", 1)
try:
    d = json.load(open(path))
except Exception as e:
    die(f"unreadable report: {e}", 1)

# report.json is the last result event alone, and every message said to a running worker
# produces a result event of its own — so on a steered run these fields describe only that
# last turn, in the direction that flatters. The stream holds all of them, so turns,
# seconds and the token counts are summed over every result event. What the run ended with
# still comes from report.json, which is the event that says how it ended. A stream with no
# readable result event falls back to report.json's own numbers, which is what an unsteered
# run sums to anyway.
totals, ms, turns, denials, found = {}, 0, 0, 0, 0
try:
    for line in open(os.path.join(run, "events.jsonl")):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") != "result":
            continue
        found += 1
        ms += e.get("duration_ms") or 0
        turns += e.get("num_turns") or 0
        denials += len(e.get("permission_denials") or [])
        for name, u in (e.get("modelUsage") or {}).items():
            t = totals.setdefault(name, {})
            for k in ("inputTokens", "outputTokens", "cacheReadInputTokens"):
                t[k] = t.get(k, 0) + (u.get(k) or 0)
except OSError:
    pass

mu = d.get("modelUsage") or {}
# The run's own model, taken from its meta file, because modelUsage holds more than the
# worker: Claude Code bills its own side work — naming a session, for one — to a small
# model of its own choosing, and that entry can come first. Measured on one Sonnet run:
# claude-haiku-4-5 at 12 output tokens sat ahead of claude-sonnet-5 at 28,185, so the
# first key named the wrong model and its numbers. A run whose meta names a model that
# never billed falls back to the busiest entry, which is the worker in every real run.
try:
    model = dict(l.strip().split("=", 1)
                 for l in open(os.path.join(run, "meta")) if "=" in l).get("model") or ""
except OSError:
    model = ""
if model not in mu and model not in totals:
    model = max(mu, key=lambda k: (mu[k] or {}).get("outputTokens") or 0, default="?")
m = totals[model] if model in totals else mu.get(model, {})
if not found:
    ms = d.get("duration_ms", 0)
    turns = d.get("num_turns", 0)
secs = round(ms / 1000)
print(
    f"model={model} "
    f"in={m.get('inputTokens', 0)} "
    f"out={m.get('outputTokens', 0)} "
    f"cache_read={m.get('cacheReadInputTokens', 0)} "
    f"turns={turns} "
    f"secs={secs} "
    f"error={d.get('is_error')} "
    f"ended={d.get('terminal_reason') or d.get('stop_reason')}"
)
# Counted across every result event for the same reason the turns are: a denial in an
# earlier turn of a steered run is still a denial the manager has to know about.
if not found:
    denials = len(d.get("permission_denials") or [])
if denials:
    print(f"denials={denials}")
