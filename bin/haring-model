#!/bin/sh
# haring-model — the models a worker in this project runs on, and the worker choices.
#
#   haring-model
#   haring-model --worker [<name>]
#   haring-model --qa [<name>]
#   haring-model <kind> <model>
#   haring-model <kind> --clear
#
# With no argument, prints the settled worker and, for each kind, the model it runs on
# and where that model came from. A kind's model is its line in <haring-root>/models,
# <worker> <kind> <model>, one setting per line; else the model: line of
# workers/<worker>/agents/<kind>.md. The qa kind has a worker of its own, so the output
# also names the QA worker and its model. A missing model prints none with the agent
# file path; a model from the models file prints that file's path.
#
# --worker reads or writes the worker choice. It settles from <project>/.haring/worker,
# then <haring-root>/worker, then copilot-agent. With a name it writes that name into
# <haring-root>/worker, or <project>/.haring/worker with --project.
#
# --qa does the same for the QA worker, read from <project>/.haring/qa-worker, then
# <haring-root>/qa-worker, then copilot-agent. Its read prints the QA worker, where it came
# from, and the qa model for that worker. With a name it writes it into
# <haring-root>/qa-worker, or <project>/.haring/qa-worker with --project.
#
# <kind> <model> writes the kind's model into <haring-root>/models for the worker the
# kind settles to: check, errand and implement use the settled worker, qa uses the
# settled QA worker. It replaces any line for that worker and kind and keeps every
# other line. <kind> --clear removes that worker and kind's line. After a write or
# --clear, when workers/<worker>/agents-config exists, haring-model runs its install
# with the output on standard error, so an installed subagent reflects the change; a
# failed reinstall exits 1 after saying the models file was written.
#
# Both worker writes refuse a name with no folder under workers/. A model write needs
# one of the four kinds; a bare model name is a usage error.
#
# project is the git top level of the current directory, resolved the same way
# bin/haring-worker resolves a workdir.
#
# Exits 2 when called wrongly: an unknown option or kind, a bare model name, --worker
# and --qa together, --project with a model write, or a name with no worker folder.
# Exits 1 when haring's own directory could not be found, a choice or model could not
# be written, or the worker's agents could not be reinstalled.
set -e

# The last fallback for the settled worker, and for the QA worker.
WORKER_DEFAULT=copilot-agent
QA_WORKER_DEFAULT=copilot-agent

# The kinds a run of the settled worker uses, in the order they are printed. Each one
# has an agent file under workers/<worker>/agents/.
KINDS="check errand implement"

usage() {
  echo "usage: haring-model [--worker [<name>]] [--qa [<name>]] [--project]" >&2
  echo "       haring-model <kind> <model>" >&2
  echo "       haring-model <kind> --clear" >&2
  exit 2
}

# Resolve our own real location, following symlinks, so this keeps working when
# it is linked onto PATH by install.sh — the same resolution bin/haring-worker uses.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd) || { echo "haring-model: could not find haring's own directory" >&2; exit 1; }

# The project is the git top level of the current directory, resolved the same way
# bin/haring-worker resolves a workdir.
project=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null || pwd)

# A choice settles from the project's own file, then haring's, then the default. A file
# that is missing, empty, or holds only whitespace names nothing and is passed over.
settle_choice() {  # settle_choice <project-file> <haring-file> <default>
  choice=$3
  choice_source=""
  for choice_file in "$1" "$2"; do
    [ -f "$choice_file" ] || continue
    candidate=$(tr -d '[:space:]' < "$choice_file")
    [ -n "$candidate" ] || continue
    choice=$candidate
    choice_source=$choice_file
    break
  done
}

# A kind's model may be set in <haring-root>/models, one <worker> <kind> <model> per
# line. Blank lines and lines whose first word starts with # are ignored, and the last
# line for a worker and kind wins.
models_model_of() {  # models_model_of <worker> <kind>
  models_model=""
  [ -f "$HARING/models" ] || return 0
  while read -r models_worker models_kind models_name models_rest || [ -n "$models_worker" ]; do
    case "$models_worker" in
      ''|'#'*) continue ;;
    esac
    [ "$models_worker" = "$1" ] && [ "$models_kind" = "$2" ] || continue
    [ -n "$models_name" ] || continue
    models_model=$models_name
  done < "$HARING/models"
}

# A kind's model is the models file's line for the worker and kind, else the model:
# line of its agent file. The line is read from column 1, the rest of the line is the
# model, and surrounding whitespace is not part of it.
agent_model_of() {  # agent_model_of <worker> <kind>
  agent_file="$HARING/workers/$1/agents/$2.md"
  agent_model=""
  models_model_of "$1" "$2"
  if [ -n "$models_model" ]; then
    agent_model=$models_model
    agent_file="$HARING/models"
    return 0
  fi
  if [ -f "$agent_file" ]; then
    agent_model=$(sed -n 's/^model:[[:space:]]*//p' "$agent_file" | sed -n 1p | tr -d '[:space:]')
  fi
}

# Write one model setting into <haring-root>/models, replacing every line for that
# worker and kind and keeping every other line as it was.
write_model() {  # write_model <worker> <kind> <model>
  models_file="$HARING/models"
  models_tmp="$models_file.tmp.$$"
  if [ -f "$models_file" ]; then
    awk -v worker="$1" -v kind="$2" '
      {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        if (line == "" || line ~ /^#/) { print; next }
        split(line, field, /[[:space:]]+/)
        if (field[1] == worker && field[2] == kind) next
        print
      }' "$models_file" > "$models_tmp"
  else
    : > "$models_tmp"
  fi
  printf '%s %s %s\n' "$1" "$2" "$3" >> "$models_tmp" || {
    rm -f "$models_tmp"; echo "haring-model: could not write $models_file" >&2; exit 1; }
  mv "$models_tmp" "$models_file" || {
    rm -f "$models_tmp"; echo "haring-model: could not write $models_file" >&2; exit 1; }
  echo "$1 $2: $3 -> $models_file"
}

# Remove every line for a worker and kind from <haring-root>/models and say what the
# last one set, or that nothing was set.
clear_model() {  # clear_model <worker> <kind>
  models_file="$HARING/models"
  models_model_of "$1" "$2"
  if [ -z "$models_model" ]; then
    echo "$1 $2: nothing set"
    return 0
  fi
  removed=$models_model
  models_tmp="$models_file.tmp.$$"
  awk -v worker="$1" -v kind="$2" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (line == "" || line ~ /^#/) { print; next }
      split(line, field, /[[:space:]]+/)
      if (field[1] == worker && field[2] == kind) next
      print
    }' "$models_file" > "$models_tmp" || {
    rm -f "$models_tmp"; echo "haring-model: could not write $models_file" >&2; exit 1; }
  mv "$models_tmp" "$models_file" || {
    rm -f "$models_tmp"; echo "haring-model: could not write $models_file" >&2; exit 1; }
  echo "$1 $2: $removed removed from $models_file"
}

# Write a settled worker name, into the project's file with --project, else haring's.
# A name with no worker folder is refused, so a typo never becomes the choice.
write_choice() {  # write_choice <name> <project-file> <haring-file>
  if [ ! -d "$HARING/workers/$1" ]; then
    worker_names=""
    for worker_dir in "$HARING"/workers/*/; do
      [ -d "$worker_dir" ] || continue
      name=${worker_dir%/}
      worker_names="$worker_names ${name##*/}"
    done
    echo "haring-model: unknown worker: $1" >&2
    echo "  the worker folders are:${worker_names}" >&2
    exit 2
  fi
  if [ -n "$project_flag" ]; then
    mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
    dest=$2
  else
    dest=$3
  fi
  printf '%s\n' "$1" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
  echo "$1 -> $dest"
}

project_flag=""
worker_flag=""
worker_write=""
qa_flag=""
qa_write=""
model_kind=""
model_name=""
clear_flag=""
while [ $# -gt 0 ]; do
  case "$1" in
    --project) project_flag=1; shift ;;
    --worker) worker_flag=1; shift
          # The name is optional: the next word is it unless it is another flag.
          case "${1-}" in
            ''|-*) ;;
            *) worker_write=$1; shift ;;
          esac ;;
    --qa) qa_flag=1; shift
          case "${1-}" in
            ''|-*) ;;
            *) qa_write=$1; shift ;;
          esac ;;
    --clear) clear_flag=1; shift ;;
    -*) echo "haring-model: unknown option: $1" >&2; usage ;;
    *)
          if [ -z "$model_kind" ]; then
            model_kind=$1
          elif [ -z "$clear_flag" ] && [ -z "$model_name" ]; then
            model_name=$1
          else
            echo "haring-model: unexpected argument: $1" >&2; usage
          fi
          shift ;;
  esac
done

if [ -n "$clear_flag" ] && [ -z "$model_kind" ]; then
  echo "haring-model: --clear needs a kind" >&2
  usage
fi

if [ -n "$model_kind" ]; then
  if [ -z "$model_name" ] && [ -z "$clear_flag" ]; then
    echo "haring-model: takes no model name: $model_kind" >&2; usage
  fi
  [ -z "$clear_flag" ] || [ -z "$model_name" ] || {
    echo "haring-model: give a model or --clear, not both" >&2; usage; }
  case "$model_kind" in
    check|errand|implement|qa) ;;
    *) echo "haring-model: unknown kind: $model_kind" >&2
       echo "  the kinds are: check errand implement qa" >&2
       usage ;;
  esac
  [ -z "$project_flag" ] || {
    echo "haring-model: --project does not go with a model write" >&2; usage; }
  [ -z "$worker_flag" ] && [ -z "$qa_flag" ] || {
    echo "haring-model: a model write does not go with --worker or --qa" >&2; usage; }
  if [ "$model_kind" = qa ]; then
    settle_choice "$project/.haring/qa-worker" "$HARING/qa-worker" "$QA_WORKER_DEFAULT"
  else
    settle_choice "$project/.haring/worker" "$HARING/worker" "$WORKER_DEFAULT"
  fi
  if [ -n "$clear_flag" ]; then
    clear_model "$choice" "$model_kind"
  else
    write_model "$choice" "$model_kind" "$model_name"
  fi
  agents_config="$HARING/workers/$choice/agents-config"
  if [ -f "$agents_config" ]; then
    if ! "$agents_config" install >&2; then
      echo "haring-model: the models file was written, but the agents could not be reinstalled." >&2
      exit 1
    fi
  fi
  exit 0
fi

[ -z "$worker_flag" ] || [ -z "$qa_flag" ] || {
  echo "haring-model: --worker and --qa do not go together" >&2; usage; }

if [ -n "$worker_flag" ]; then
  if [ -n "$worker_write" ]; then
    write_choice "$worker_write" "$project/.haring/worker" "$HARING/worker"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a worker name to write" >&2; usage; }
  settle_choice "$project/.haring/worker" "$HARING/worker" "$WORKER_DEFAULT"
  if [ -n "$choice_source" ]; then
    echo "$choice ($choice_source)"
  else
    echo "$choice (default)"
  fi
  exit 0
fi

if [ -n "$qa_flag" ]; then
  if [ -n "$qa_write" ]; then
    write_choice "$qa_write" "$project/.haring/qa-worker" "$HARING/qa-worker"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a worker name to write" >&2; usage; }
  settle_choice "$project/.haring/qa-worker" "$HARING/qa-worker" "$QA_WORKER_DEFAULT"
  if [ -n "$choice_source" ]; then
    echo "$choice ($choice_source)"
  else
    echo "$choice (default)"
  fi
  agent_model_of "$choice" qa
  if [ -n "$agent_model" ]; then
    echo "qa: $agent_model ($agent_file)"
  else
    echo "qa: none ($agent_file)"
  fi
  exit 0
fi

[ -z "$project_flag" ] || { echo "haring-model: --project needs a worker name to write" >&2; usage; }

settle_choice "$project/.haring/worker" "$HARING/worker" "$WORKER_DEFAULT"
worker=$choice
worker_source=$choice_source
settle_choice "$project/.haring/qa-worker" "$HARING/qa-worker" "$QA_WORKER_DEFAULT"
qa_worker=$choice
qa_worker_source=$choice_source

if [ -n "$worker_source" ]; then
  echo "$worker ($worker_source)"
else
  echo "$worker (default)"
fi
for kind in $KINDS; do
  agent_model_of "$worker" "$kind"
  if [ -n "$agent_model" ]; then
    echo "$kind: $agent_model ($agent_file)"
  else
    echo "$kind: none ($agent_file)"
  fi
done
if [ -n "$qa_worker_source" ]; then
  echo "qa worker: $qa_worker ($qa_worker_source)"
else
  echo "qa worker: $qa_worker (default)"
fi
agent_model_of "$qa_worker" qa
if [ -n "$agent_model" ]; then
  echo "qa: $agent_model ($agent_file)"
else
  echo "qa: none ($agent_file)"
fi
