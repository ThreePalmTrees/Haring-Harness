#!/bin/sh
# haring-model — the model a worker in this project runs on: read it, or set it.
#
#   haring-model
#   haring-model <model>
#   haring-model --project <model>
#   haring-model --qa [<model>]
#   haring-model --qa-mode [<auto|ask|never>]
#
# With no argument, prints the model a worker started here would run on, and where
# that came from — the same order bin/haring-worker settles a fresh run's model
# from, minus --model, which only a launch itself can give: <project>/.haring/model,
# then <haring-root>/model, then the default, claude-sonnet-5.
#
# With one argument, writes that name into <haring-root>/model — haring's own
# choice, in force everywhere unless a project overrides it — and prints what it
# wrote. --project writes <project>/.haring/model instead: the per-project
# override, set the same way it is read.
#
# --qa reads or writes the QA model the same way the plain surface reads and
# writes the worker model, from the same two places minus any default:
# <project>/.haring/qa-model, then <haring-root>/qa-model. A QA pass runs on a
# model the client chose, so no default sits behind the two files: when neither
# names one, the read prints "qa model unset" and exits 1 — the one answer the
# plain read never has to give.
#
# --qa-mode reads or writes the QA mode the same way, from
# <project>/.haring/qa-mode, then <haring-root>/qa-mode. A read prints what a
# file holds without validating it — a hand edit is printed as it stands; only a
# write validates, and takes one of auto, ask or never. When neither file names
# a mode, the read prints "ask (default)" and exits 0: ask is the mode the
# manager falls back to.
#
# The model is one of four — claude-opus-5, claude-sonnet-5, glm-5.3, glm-5.3-flash,
# the same four bin/haring-worker accepts — and a name outside that list is refused.
#
# project is the git top level of the current directory, resolved the same way
# bin/haring-worker resolves a workdir.
#
# Exits 2 when called wrongly: an unknown option, more than one model name, the two
# QA surfaces in one call, a plain model name beside a QA surface, a model name
# outside the four, or a mode outside the three. Exits 1 when called rightly but
# unable to finish — haring's own directory could not be found, the file could not
# be written, or the QA model is unset.
set -e

MODEL_DEFAULT=claude-sonnet-5

usage() {
  echo "usage: haring-model [<model>] [--qa [<model>]] [--qa-mode <auto|ask|never>] [--project]" >&2
  exit 2
}

is_model() {
  case "$1" in
    claude-opus-5 | claude-sonnet-5 | glm-5.3 | glm-5.3-flash) return 0 ;;
    *) return 1 ;;
  esac
}

# Resolve our own real location, following symlinks, so this keeps working when
# it is linked onto PATH by install.sh — the same resolution bin/haring-worker uses.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd) || { echo "haring-model: could not find haring's own directory" >&2; exit 1; }

project_flag=""
model=""
qa_flag=""
qa_write=""
qa_mode_flag=""
qa_mode_write=""
while [ $# -gt 0 ]; do
  case "$1" in
    --project) project_flag=1; shift ;;
    --qa) qa_flag=1; shift
          # The model is optional: the next word is it unless it is another flag.
          case "${1-}" in
            ''|-*) ;;
            *) qa_write=$1; shift ;;
          esac ;;
    --qa-mode) qa_mode_flag=1; shift
          case "${1-}" in
            ''|-*) ;;
            *) qa_mode_write=$1; shift ;;
          esac ;;
    -*) echo "haring-model: unknown option: $1" >&2; usage ;;
    *) [ -z "$model" ] || { echo "haring-model: takes at most one model name" >&2; usage; }
       model=$1; shift ;;
  esac
done

[ -z "$qa_flag" ] || [ -z "$qa_mode_flag" ] || {
  echo "haring-model: --qa and --qa-mode do not go together" >&2; usage; }
[ -z "$model" ] || [ -z "$qa_flag$qa_mode_flag" ] || {
  echo "haring-model: a plain model name does not go with --qa or --qa-mode" >&2; usage; }

project=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null || pwd)

if [ -n "$qa_flag" ]; then
  if [ -n "$qa_write" ]; then
    if ! is_model "$qa_write"; then
      echo "haring-model: unknown model: $qa_write" >&2
      echo "  haring-model takes one of: claude-opus-5, claude-sonnet-5," >&2
      echo "  glm-5.3, glm-5.3-flash." >&2
      exit 2
    fi
    if [ -n "$project_flag" ]; then
      mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
      dest="$project/.haring/qa-model"
    else
      dest="$HARING/qa-model"
    fi
    printf '%s\n' "$qa_write" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
    echo "$qa_write -> $dest"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a model name to write" >&2; usage; }
  # The same rule the plain read applies: a file that is missing, empty, or holds
  # only whitespace names nothing and is passed over rather than treated as a
  # choice. Nothing behind the two files is the answer, not a failure to answer.
  for model_file in "$project/.haring/qa-model" "$HARING/qa-model"; do
    [ -f "$model_file" ] || continue
    candidate=$(tr -d '[:space:]' < "$model_file")
    [ -n "$candidate" ] || continue
    echo "$candidate ($model_file)"
    exit 0
  done
  echo "qa model unset"
  exit 1
fi

if [ -n "$qa_mode_flag" ]; then
  if [ -n "$qa_mode_write" ]; then
    case "$qa_mode_write" in
      auto | ask | never) ;;
      *) echo "haring-model: unknown qa mode: $qa_mode_write" >&2
         echo "  haring-model takes one of: auto, ask, never." >&2
         exit 2 ;;
    esac
    if [ -n "$project_flag" ]; then
      mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
      dest="$project/.haring/qa-mode"
    else
      dest="$HARING/qa-mode"
    fi
    printf '%s\n' "$qa_mode_write" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
    echo "$qa_mode_write -> $dest"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a mode to write" >&2; usage; }
  # Reads do not validate: a hand-edited mode is printed as it stands, and only a
  # write decides what the three words are.
  for mode_file in "$project/.haring/qa-mode" "$HARING/qa-mode"; do
    [ -f "$mode_file" ] || continue
    candidate=$(tr -d '[:space:]' < "$mode_file")
    [ -n "$candidate" ] || continue
    echo "$candidate ($mode_file)"
    exit 0
  done
  echo "ask (default)"
  exit 0
fi

if [ -n "$model" ]; then
  if ! is_model "$model"; then
    echo "haring-model: unknown model: $model" >&2
    echo "  haring-model takes one of: claude-opus-5, claude-sonnet-5," >&2
    echo "  glm-5.3, glm-5.3-flash." >&2
    exit 2
  fi
  if [ -n "$project_flag" ]; then
    mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
    dest="$project/.haring/model"
  else
    dest="$HARING/model"
  fi
  printf '%s\n' "$model" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
  echo "$model -> $dest"
  exit 0
fi

[ -z "$project_flag" ] || { echo "haring-model: --project needs a model name to write" >&2; usage; }

# The same order bin/haring-worker settles a fresh run's model from, minus --model.
# A file that is missing, empty, or holds only whitespace names nothing and is
# passed over rather than treated as a choice.
for model_file in "$project/.haring/model" "$HARING/model"; do
  [ -f "$model_file" ] || continue
  candidate=$(tr -d '[:space:]' < "$model_file")
  [ -n "$candidate" ] || continue
  echo "$candidate ($model_file)"
  exit 0
done
echo "$MODEL_DEFAULT (default)"
