#!/bin/sh
# haring-model — the model a worker in this project runs on: read it, or set it.
#
#   haring-model
#   haring-model <model>
#   haring-model --project <model>
#   haring-model --qa [<model>]
#   haring-model --worker [<name>]
#
# With no argument, prints the model a worker started here would run on, and where
# that came from — the same order bin/haring-worker settles a fresh run's model
# from, minus --model, which only a launch itself can give: <project>/.haring/model,
# then <haring-root>/model, then the default named in that run's worker.conf. The
# worker settles the same way: <project>/.haring/worker, then <haring-root>/worker,
# then opencode.
#
# --worker reads or writes that worker choice. With no name it prints the settled
# worker and where it came from. With a name it writes the name into
# <haring-root>/worker, or <project>/.haring/worker with --project, and refuses a name
# that has no folder under workers/.
#
# With one argument, writes that name into <haring-root>/model — haring's own
# choice, in force everywhere unless a project overrides it — and prints what it
# wrote. --project writes <project>/.haring/model instead: the per-project
# override, set the same way it is read.
#
# --qa reads or writes the model a QA pass runs on, from the same two places:
# <project>/.haring/qa-model, then <haring-root>/qa-model. A QA pass runs only when
# the client asks for one. With neither file naming a model it runs on opus, as the
# Claude Code agent haring-qa, and the read says so. opus and sonnet run as that
# agent on that model; an OpenCode model runs as a haring-worker qa run.
#
# The worker model is one of those listed in the settled worker's worker.conf, the same
# ones bin/haring-worker accepts; the QA model is one of those, opus or sonnet. A name
# given on the command line is refused when it is outside the list. A saved model file
# is shared by every worker, so a file that names a model outside the settled worker's
# list is skipped, with one warning naming the file, and the next place is used.
#
# project is the git top level of the current directory, resolved the same way
# bin/haring-worker resolves a workdir.
#
# Exits 2 when called wrongly: an unknown option, more than one model name, a plain
# model name beside --qa, a model name outside the list, or --project with nothing
# to write. Exits 1 when called rightly but unable to finish — haring's own
# directory could not be found, or the file could not be written.
set -e

# The last fallback for the worker whose model list this reads.
WORKER_DEFAULT=opencode

usage() {
  echo "usage: haring-model [<model>] [--qa [<model>]] [--worker [<name>]] [--project]" >&2
  exit 2
}

# Resolve our own real location, following symlinks, so this keeps working when
# it is linked onto PATH by install.sh — the same resolution bin/haring-worker uses.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *)  self=$(dirname -- "$self")/$link ;;
  esac
done
HARING=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd) || { echo "haring-model: could not find haring's own directory" >&2; exit 1; }

# The project is the git top level of the current directory, resolved the same way
# bin/haring-worker resolves a workdir.
project=$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null || pwd)

# The worker a fresh run here uses settles from the project's own choice, then haring's,
# then the default. A file that is missing, empty, or holds only whitespace names nothing
# and is passed over rather than treated as a choice.
worker=$WORKER_DEFAULT
worker_source=""
for worker_file in "$project/.haring/worker" "$HARING/worker"; do
  [ -f "$worker_file" ] || continue
  candidate=$(tr -d '[:space:]' < "$worker_file")
  [ -n "$candidate" ] || continue
  worker=$candidate
  worker_source=$worker_file
  break
done

# The models a worker may run on, written the way `opencode run -m` takes them, live in
# the worker's own worker.conf: default_model= names the default and models= lists what
# may be chosen. A worker with no readable list is refused here rather than validating
# names against nothing.
worker_conf="$HARING/workers/$worker/worker.conf"
MODEL_DEFAULT=""
MODELS=""
if [ -r "$worker_conf" ]; then
  MODEL_DEFAULT=$(sed -n 's/^default_model=//p' "$worker_conf" | sed -n 1p)
  MODELS=$(sed -n 's/^models=//p' "$worker_conf" | sed -n 1p)
fi
if [ -z "$MODEL_DEFAULT" ] || [ -z "$MODELS" ]; then
  echo "haring-model: the $worker worker has no model list: $worker_conf is missing or unreadable." >&2
  exit 1
fi
is_model() {
  case " $MODELS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

project_flag=""
model=""
qa_flag=""
qa_write=""
worker_flag=""
worker_write=""
while [ $# -gt 0 ]; do
  case "$1" in
    --project) project_flag=1; shift ;;
    --qa) qa_flag=1; shift
          # The model is optional: the next word is it unless it is another flag.
          case "${1-}" in
            ''|-*) ;;
            *) qa_write=$1; shift ;;
          esac ;;
    --worker) worker_flag=1; shift
          # The name is optional: the next word is it unless it is another flag.
          case "${1-}" in
            ''|-*) ;;
            *) worker_write=$1; shift ;;
          esac ;;
    -*) echo "haring-model: unknown option: $1" >&2; usage ;;
    *) [ -z "$model" ] || { echo "haring-model: takes at most one model name" >&2; usage; }
       model=$1; shift ;;
  esac
done

[ -z "$model" ] || [ -z "$qa_flag" ] || {
  echo "haring-model: a plain model name does not go with --qa" >&2; usage; }
[ -z "$model" ] || [ -z "$worker_flag" ] || {
  echo "haring-model: a plain model name does not go with --worker" >&2; usage; }
[ -z "$qa_flag" ] || [ -z "$worker_flag" ] || {
  echo "haring-model: --qa and --worker do not go together" >&2; usage; }

if [ -n "$worker_flag" ]; then
  if [ -n "$worker_write" ]; then
    if [ ! -d "$HARING/workers/$worker_write" ]; then
      worker_names=""
      for worker_dir in "$HARING"/workers/*/; do
        [ -d "$worker_dir" ] || continue
        name=${worker_dir%/}
        worker_names="$worker_names ${name##*/}"
      done
      echo "haring-model: unknown worker: $worker_write" >&2
      echo "  the worker folders are:${worker_names}" >&2
      exit 2
    fi
    if [ -n "$project_flag" ]; then
      mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
      dest="$project/.haring/worker"
    else
      dest="$HARING/worker"
    fi
    printf '%s\n' "$worker_write" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
    echo "$worker_write -> $dest"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a worker name to write" >&2; usage; }
  # The same rule the model read applies: a file that is missing, empty, or holds only
  # whitespace names nothing and is passed over rather than treated as a choice.
  if [ -n "$worker_source" ]; then
    echo "$worker ($worker_source)"
  else
    echo "$worker (default)"
  fi
  exit 0
fi

if [ -n "$qa_flag" ]; then
  if [ -n "$qa_write" ]; then
    if ! is_model "$qa_write" && [ "$qa_write" != opus ] && [ "$qa_write" != sonnet ]; then
      echo "haring-model: unknown QA model: $qa_write" >&2
      echo "  haring-model --qa takes one of: opus, sonnet, $MODELS." >&2
      exit 2
    fi
    if [ -n "$project_flag" ]; then
      mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
      dest="$project/.haring/qa-model"
    else
      dest="$HARING/qa-model"
    fi
    printf '%s\n' "$qa_write" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
    echo "$qa_write -> $dest"
    exit 0
  fi
  [ -z "$project_flag" ] || { echo "haring-model: --project needs a model name to write" >&2; usage; }
  # The same rule the plain read applies: a file that is missing, empty, or holds
  # only whitespace names nothing and is passed over rather than treated as a
  # choice. Nothing behind the two files is the answer, not a failure to answer.
  for model_file in "$project/.haring/qa-model" "$HARING/qa-model"; do
    [ -f "$model_file" ] || continue
    candidate=$(tr -d '[:space:]' < "$model_file")
    [ -n "$candidate" ] || continue
    echo "$candidate ($model_file)"
    exit 0
  done
  echo "opus (default: the Claude Code agent haring-qa)"
  exit 0
fi

if [ -n "$model" ]; then
  if ! is_model "$model"; then
    echo "haring-model: unknown model: $model" >&2
    echo "  haring-model takes one of: $MODELS" >&2
    exit 2
  fi
  if [ -n "$project_flag" ]; then
    mkdir -p "$project/.haring" || { echo "haring-model: could not create $project/.haring" >&2; exit 1; }
    dest="$project/.haring/model"
  else
    dest="$HARING/model"
  fi
  printf '%s\n' "$model" > "$dest" || { echo "haring-model: could not write $dest" >&2; exit 1; }
  echo "$model -> $dest"
  exit 0
fi

[ -z "$project_flag" ] || { echo "haring-model: --project needs a model name to write" >&2; usage; }

# The same order bin/haring-worker settles a fresh run's model from, minus --model.
# A file that is missing, empty, or holds only whitespace names nothing and is
# passed over rather than treated as a choice. A file that names a model outside the
# settled worker's list is passed over too, with one warning naming the file.
for model_file in "$project/.haring/model" "$HARING/model"; do
  [ -f "$model_file" ] || continue
  candidate=$(tr -d '[:space:]' < "$model_file")
  [ -n "$candidate" ] || continue
  if ! is_model "$candidate"; then
    echo "haring-model: ignoring $model_file: $candidate is not in the $worker worker's models ($MODELS)." >&2
    continue
  fi
  echo "$candidate ($model_file)"
  exit 0
done
echo "$MODEL_DEFAULT (default)"
