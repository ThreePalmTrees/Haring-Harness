{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "answers": {
   "type": "array",
   "description": "One entry for every numbered thing the task asked for. If you could not answer one, say why in detail. Never leave a number out.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "n": {
      "type": "integer"
     },
     "verdict": {
      "type": "string",
      "enum": [
       "agree",
       "disagree",
       "partly",
       "answered",
       "could_not"
      ]
     },
     "detail": {
      "type": "string"
     },
     "where": {
      "type": "string"
     },
     "evidence": {
      "type": "string",
      "enum": [
       "ran_a_command",
       "read_the_code",
       "reasoning_only"
      ]
     }
    },
    "required": [
     "n",
     "verdict",
     "detail",
     "where",
     "evidence"
    ]
   }
  },
  "files_changed": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "verification": {
   "type": "array",
   "description": "the manager names the commands and the worker runs them",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "command": {
      "type": "string"
     },
     "output": {
      "type": "string"
     }
    },
    "required": [
     "command",
     "output"
    ]
   }
  },
  "commit": {
   "type": "string",
   "description": "the one commit made, or empty with the reason in a doubt"
  },
  "blocked": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "hit": {
     "type": "string",
     "description": "what stopped you: a forbidden action, something not installed that you may not install yourself, or a part of the task that contradicts what the code actually does"
    },
    "needed_to_continue": {
     "type": "string",
     "description": "exactly what you would need, or what the manager has to decide"
    }
   },
   "required": [
    "hit",
    "needed_to_continue"
   ]
  },
  "redacted": {
   "type": "boolean",
   "description": "true if anything was removed from this report for being a secret"
  },
  "doubts": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "needs_the_client": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "did_not_check": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "weak_evidence": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "needs_the_client",
    "did_not_check",
    "weak_evidence"
   ]
  }
 },
 "required": [
  "answers",
  "files_changed",
  "verification",
  "commit",
  "doubts",
  "redacted"
 ]
}
