{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "files_changed": {
   "type": "array",
   "description": "the paths that changed",
   "items": {
    "type": "string"
   }
  },
  "verification": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "command": {
     "type": "string",
     "description": "the command the manager named in its review"
    },
    "output": {
     "type": "string",
     "description": "what that command printed"
    }
   },
   "required": [
    "command",
    "output"
   ]
  },
  "commit": {
   "type": "string",
   "description": "the one commit made, or empty with the reason in a doubt"
  },
  "review_points": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "quote": {
      "type": "string",
      "description": "the manager's words being answered"
     },
     "action": {
      "type": "string",
      "enum": [
       "changed",
       "left_alone_as_told",
       "disagreed_and_did_it",
       "did_not_do"
      ]
     },
     "detail": {
      "type": "string"
     },
     "where": {
      "type": "string"
     }
    },
    "required": [
     "quote",
     "action",
     "detail",
     "where"
    ]
   }
  },
  "blocked": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "hit": {
     "type": "string",
     "description": "what stopped you: a forbidden action, something not installed that you may not install yourself, or a part of the task that contradicts what the code actually does"
    },
    "needed_to_continue": {
     "type": "string",
     "description": "exactly what you would need, or what the manager has to decide"
    }
   },
   "required": [
    "hit",
    "needed_to_continue"
   ]
  },
  "redacted": {
   "type": "boolean",
   "description": "true if anything was removed from this report for being a secret"
  },
  "doubts": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "needs_the_client": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "did_not_check": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "weak_evidence": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "needs_the_client",
    "did_not_check",
    "weak_evidence"
   ]
  }
 },
 "required": [
  "review_points",
  "files_changed",
  "verification",
  "commit",
  "redacted",
  "doubts"
 ]
}
